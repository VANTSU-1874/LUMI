wait_for_health() {
  local destination=$1
  local timeout_seconds=${2:-$HEALTH_STARTUP_TIMEOUT_SECONDS}
  local deadline=$((SECONDS + timeout_seconds))
  local attempts=0

  while (( SECONDS < deadline )); do
    attempts=$((attempts + 1))
    if capture_health "$destination" "$HEALTH_RETRY_CURL_TIMEOUT_SECONDS" >/dev/null 2>&1; then
      printf 'HEALTH_OK\n'
      printf 'HEALTH_READY_ATTEMPTS=%s\n' "$attempts"
      return 0
    fi
    sleep 1
  done

  printf 'HEALTH_WAIT_TIMEOUT_SECONDS=%s\n' "$timeout_seconds" >&2
  return 1
}

wait_for_base_health() {
  local destination=$1
  local timeout_seconds=${2:-$HEALTH_STARTUP_TIMEOUT_SECONDS}
  local deadline=$((SECONDS + timeout_seconds))
  local attempts=0

  while (( SECONDS < deadline )); do
    attempts=$((attempts + 1))
    if capture_base_health "$destination" "$HEALTH_RETRY_CURL_TIMEOUT_SECONDS" >/dev/null 2>&1; then
      printf 'BASE_HEALTH_OK\n'
      printf 'BASE_HEALTH_READY_ATTEMPTS=%s\n' "$attempts"
      return 0
    fi
    sleep 1
  done

  printf 'BASE_HEALTH_WAIT_TIMEOUT_SECONDS=%s\n' "$timeout_seconds" >&2
  return 1
}

