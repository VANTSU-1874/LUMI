verify_next_external_module_aliases() {
  local release=$1
  [[ -d "$release" && ! -L "$release" ]]

  runuser -u "$SERVICE_USER" -- "$RUNTIME_NODE" - "$release" <<'JS'
const fs = require("node:fs");
const path = require("node:path");
const { createRequire } = require("node:module");

const release = path.resolve(process.argv[2]);
const nextRoot = path.join(release, ".next");
const serverRoot = path.join(nextRoot, "server");
const aliasRoot = path.join(nextRoot, "node_modules");
const releaseModulesRoot = path.join(release, "node_modules") + path.sep;
const requiredAliases = new Set();

function walk(directory) {
  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
    const entryPath = path.join(directory, entry.name);
    if (entry.isDirectory()) {
      walk(entryPath);
    } else if (entry.isFile() && entry.name.endsWith(".nft.json")) {
      const trace = JSON.parse(fs.readFileSync(entryPath, "utf8"));
      if (!Array.isArray(trace.files)) {
        throw new Error("NEXT_TRACE_FILES_INVALID");
      }
      for (const traced of trace.files) {
        if (typeof traced !== "string") {
          throw new Error("NEXT_TRACE_FILE_INVALID");
        }
        const resolved = path.resolve(path.dirname(entryPath), traced);
        const relative = path.relative(aliasRoot, resolved);
        if (
          relative &&
          !relative.startsWith(`..${path.sep}`) &&
          relative !== ".." &&
          !path.isAbsolute(relative)
        ) {
          requiredAliases.add(relative.split(path.sep)[0]);
        }
      }
    }
  }
