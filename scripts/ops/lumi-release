failed_cutover_evidence_count() {
  local commit=$1
  python3 - "$EVIDENCE_ROOT" "$commit" <<'PY'
from pathlib import Path
import stat
import sys

root = Path(sys.argv[1])
commit = sys.argv[2]
count = 0
for candidate in root.iterdir():
    result = candidate / "FAILED.result"
    try:
        mode = result.lstat().st_mode
    except FileNotFoundError:
        continue
    if not stat.S_ISREG(mode):
        continue
    fields = {}
    for line in result.read_text(encoding="utf-8").splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    if (
        fields.get("SOURCE_COMMIT") == commit
        and fields.get("PHASE") == "cutover"
        and fields.get("STATUS") == "FAILED"
    ):
        count += 1
print(count)
PY
}

successful_cutover_evidence_count() {
  local commit=$1
  python3 - "$EVIDENCE_ROOT" "$commit" <<'PY'
from pathlib import Path
import stat
import sys

root = Path(sys.argv[1])
commit = sys.argv[2]
count = 0
for candidate in root.iterdir():
    result = candidate / "SUCCEEDED.result"
    summary = candidate / "summary.log"
    try:
        result_mode = result.lstat().st_mode
        summary_mode = summary.lstat().st_mode
    except FileNotFoundError:
        continue
    if not stat.S_ISREG(result_mode) or not stat.S_ISREG(summary_mode):
        continue
    fields = {}
    for line in result.read_text(encoding="utf-8").splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    phases = {
        line.split("=", 1)[1]
        for line in summary.read_text(encoding="utf-8").splitlines()
        if line.startswith("PHASE=")
    }
    if (
        fields.get("SOURCE_COMMIT") == commit
        and fields.get("STATUS") == "SUCCEEDED"
        and "cutover" in phases
    ):
        count += 1
print(count)
PY
}

release_reference_count() {
  local release=$1
  local candidate
  local resolved
  local count=0

  shopt -s nullglob
  for candidate in /proc/[0-9]*/exe /proc/[0-9]*/cwd /proc/[0-9]*/root /proc/[0-9]*/fd/*; do
    resolved=$(readlink -f -- "$candidate" 2>/dev/null || true)
    if [[ "$resolved" == "$release" || "$resolved" == "$release/"* ]]; then
      count=$((count + 1))
    fi
  done
  shopt -u nullglob

  while IFS= read -r -d '' candidate; do
    resolved=$(readlink -f -- "$candidate" 2>/dev/null || true)
    if [[ "$resolved" == "$release" || "$resolved" == "$release/"* ]]; then
      count=$((count + 1))
    fi
  done < <(find /opt/lumi -xdev -maxdepth 2 -type l -print0)

  printf '%s\n' "$count"
}

release_seal_count() {
  local commit=$1
  local seal
  local count=0

  shopt -s nullglob
  for seal in "$SEAL_ROOT"/*.seal; do
    [[ -f "$seal" && ! -L "$seal" ]]
    if [[ "$(seal_field "$seal" source_commit)" == "$commit" ]]; then
      count=$((count + 1))
    fi
  done
  shopt -u nullglob
  printf '%s\n' "$count"
}

release_inventory() {
  local current
  local release
  local name
  local bytes
  local marker
  local marker_commit='NONE'
  local complete='NO'
  local successful_cutovers=0
  local failed_cutovers=0
  local references
  local is_current

  assert_operations_roots
  [[ -d "$RELEASE_ROOT" && ! -L "$RELEASE_ROOT" ]]
  [[ -L "$CURRENT_LINK" ]]
  current=$(readlink -f "$CURRENT_LINK")
  [[ "$current" == "$RELEASE_ROOT/"* ]]
  printf 'CURRENT=%s\n' "$current"

  while IFS= read -r -d '' release; do
    name=$(basename -- "$release")
    bytes=$(du -sb -- "$release" | awk '{print $1}')
    [[ "$bytes" =~ ^[1-9][0-9]*$ ]]
    marker="$release/.lumi-deploy-complete"
    marker_commit='NONE'
    complete='NO'
    successful_cutovers=0
    failed_cutovers=0
    if [[ -f "$marker" && ! -L "$marker" ]]; then
      marker_commit=$(awk -F= '$1 == "source_commit" { print $2 }' "$marker")
      if [[ "$marker_commit" =~ ^[0-9a-f]{40}$ ]]; then
        complete='YES'
        successful_cutovers=$(successful_cutover_evidence_count "$marker_commit")
        failed_cutovers=$(failed_cutover_evidence_count "$marker_commit")
      fi
    fi
    references=$(release_reference_count "$release")
    if [[ "$release" == "$current" ]]; then
      is_current='YES'
    else
      is_current='NO'
    fi
    printf 'RELEASE=%s|BYTES=%s|COMPLETE=%s|MARKER_COMMIT=%s|SUCCESSFUL_CUTOVERS=%s|FAILED_CUTOVERS=%s|REFERENCES=%s|CURRENT=%s\n' \
      "$name" "$bytes" "$complete" "$marker_commit" "$successful_cutovers" "$failed_cutovers" "$references" "$is_current"
  done < <(find "$RELEASE_ROOT" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

  systemctl is-active --quiet "$SERVICE"
  status_health
}

