restore_report_target() {
  local target=$1
  local previous=$2
  local backup=$3
  [[ -n "$target" ]]
  if [[ "$previous" == 'present' ]]; then
    [[ -f "$backup" && ! -L "$backup" ]]
    promote_report_file "$backup" "$target" "$(sha256sum -- "$backup" | awk '{print $1}')"
  elif [[ "$previous" == 'absent' ]]; then
    rm -f -- "$target"
  else
    return 1
  fi
}

