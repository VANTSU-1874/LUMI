main() {
  assert_root
  exec 9>"$LOCK_FILE"
  flock -n 9 || die 'ANOTHER_LUMI_RELEASE_OPERATION_IS_RUNNING'

  case "${1:-}" in
    status)
      [[ "$#" -eq 1 ]] || die 'STATUS_TAKES_NO_ARGUMENTS'
      status
      ;;
    release-inventory)
      [[ "$#" -eq 1 ]] || die 'RELEASE_INVENTORY_TAKES_NO_ARGUMENTS'
      release_inventory
      ;;
    backup)
      [[ "$#" -eq 1 ]] || die 'BACKUP_TAKES_NO_ARGUMENTS'
      backup
      ;;
    prune-retired)
      [[ "$#" -ge 2 && "$#" -le 33 ]] || die 'PRUNE_RETIRED_REQUIRES_ONE_TO_32_COMMITS'
      shift
      prune_retired_releases "$@"
      ;;
    discard-failed)
      [[ "$#" -eq 2 ]] || die 'DISCARD_FAILED_REQUIRES_COMMIT'
      discard_failed_release "$2"
      ;;
    discard-incomplete-prepare)
      [[ "$#" -eq 2 ]] || die 'DISCARD_INCOMPLETE_PREPARE_REQUIRES_COMMIT'
      discard_incomplete_prepare_release "$2"
      ;;
    discard-incomplete-prepare-work)
      [[ "$#" -eq 2 ]] || die 'DISCARD_INCOMPLETE_PREPARE_WORK_REQUIRES_COMMIT'
      discard_incomplete_prepare_work "$2"
      ;;
    discard-failed-work)
      [[ "$#" -eq 2 ]] || die 'DISCARD_FAILED_WORK_REQUIRES_COMMIT'
      discard_failed_work "$2"
      ;;
    diagnose-cutover)
      [[ "$#" -eq 2 ]] || die 'DIAGNOSE_CUTOVER_REQUIRES_FAILED_RUN_ID'
      diagnose_failed_cutover "$2"
      ;;
    diagnose-current-inspiration)
      [[ "$#" -eq 1 ]] || die 'DIAGNOSE_CURRENT_INSPIRATION_TAKES_NO_ARGUMENTS'
      diagnose_current_inspiration
      ;;
    prepare)
      [[ "$#" -eq 2 ]] || die 'PREPARE_REQUIRES_COMMIT'
      prepare "$2"
      ;;
    audit)
      [[ "$#" -eq 2 ]] || die 'AUDIT_REQUIRES_PREPARE_RUN_ID'
      audit_prepared "$2"
      ;;
    recover-audit)
      [[ "$#" -eq 3 ]] || die 'RECOVER_AUDIT_REQUIRES_PREPARE_AND_AUDIT_RUN_IDS'
      recover_audit "$2" "$3"
      ;;
    cutover-sealed)
      [[ "$#" -eq 2 ]] || die 'CUTOVER_SEALED_REQUIRES_RUN_ID'
      cutover_sealed "$2"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
