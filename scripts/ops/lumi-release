    MIGRATION_APPLIED=true
    verify_inspiration_wiki_d27_release "$release" | tee -a "$ACTIVE_EVIDENCE/database-migration.log" "$ACTIVE_EVIDENCE/summary.log"
  fi
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
