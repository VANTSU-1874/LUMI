    runuser -u "$SERVICE_USER" -- test -r "$release/.runtime/knowledge-v2-linux/python/bin/python3"
    runuser -u "$SERVICE_USER" -- test -x "$release/.runtime/knowledge-v2-linux/python/bin/python3"
  fi
  runuser -u "$SERVICE_USER" -- test -r "$marker"
  runuser -u "$SERVICE_USER" -- test -w "$release/.next/cache"
  runuser -u "$SERVICE_USER" -- test -x "$esbuild"
  local actual_esbuild
  actual_esbuild=$(runuser -u "$SERVICE_USER" -- "$esbuild" --version)
  [[ "$actual_esbuild" == "$esbuild_version" ]]
  printf 'TARGET_ESBUILD_VERSION=%s\n' "$actual_esbuild" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  runuser -u "$SERVICE_USER" -- "$RUNTIME_NODE" -e 'require(process.argv[1]); process.stdout.write("NATIVE_MODULE_LOAD=PASS\\n")' "$release/node_modules/better-sqlite3" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  verify_next_external_module_aliases "$release" | tee -a "$ACTIVE_EVIDENCE/summary.log"
}

write_seal() {
  local run_id=$1
  local commit=$2
  local expected_current=$3
  local build_id=$4
  local esbuild_version=$5
  local database_migration=$6
  local environment_write=$7
  local environment_previous=$8
  local release="$RELEASE_ROOT/$commit"
  local token
  local token_hash
  local seal="$SEAL_ROOT/$run_id.seal"
  local seal_tmp
  assert_release_policy "$database_migration" "$environment_write"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_NONE" ]]; then
    [[ "$environment_previous" == 'unmodified' ]]
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    [[ "$environment_previous" =~ ^(absent|true|false),(absent|true|false),(absent|true|false)$ ]]
  else
    [[ "$environment_previous" == 'absent' || "$environment_previous" == 'true' || "$environment_previous" == 'false' ]]
  fi
  [[ ! -e "$seal" && ! -L "$seal" ]]
  token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  token_hash=$(printf '%s' "$token" | sha256sum | awk '{print $1}')
  seal_tmp=$(mktemp "$SEAL_ROOT/.$run_id.XXXXXX")
  {
    printf 'run_id=%s\n' "$run_id"
    printf 'source_commit=%s\n' "$commit"
    printf 'expected_current=%s\n' "$expected_current"
    printf 'release=%s\n' "$release"
    printf 'build_id=%s\n' "$build_id"
    printf 'esbuild_version=%s\n' "$esbuild_version"
    printf 'database_migration=%s\n' "$database_migration"
    printf 'environment_write=%s\n' "$environment_write"
    printf 'environment_previous=%s\n' "$environment_previous"
    printf 'token_sha256=%s\n' "$token_hash"
  } > "$seal_tmp"
  chown root:root "$seal_tmp"
  chmod 0600 "$seal_tmp"
  mv -f -- "$seal_tmp" "$seal"
  printf '%s\n' "$token"
}

seal_field() {
  local seal=$1
  local field=$2
  awk -F= -v key="$field" '$1 == key { print substr($0, length(key) + 2) }' "$seal"
}

prepare() {
  local commit=$1
  local run_id
  local input_root_real
  local input_dir
  local stage
  local manifest
  local expected_current
  local source_sha256
  local built_sha256
  local build_id
  local esbuild_version
  local database_migration
  local environment_write
  local environment_previous
  local source_archive
  local built_archive
  local release
  local confirmation_token

  assert_commit "$commit"
  assert_operations_roots
  input_root_real=$(realpath -e -- "$INPUT_ROOT")
  input_dir=$(realpath -e -- "$INPUT_ROOT/$commit")
  [[ "$input_dir" == "$input_root_real/$commit" && -d "$input_dir" && ! -L "$input_dir" ]]
  for required in manifest manifest.sig source.tar built.tar.gz; do
    [[ -f "$input_dir/$required" && ! -L "$input_dir/$required" ]]
  done

  run_id="prepare-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence prepare "$run_id"
  ACTIVE_COMMIT="$commit"
  stage="$WORK_ROOT/$run_id"
  [[ ! -e "$stage" && ! -L "$stage" ]]
  install -d -o root -g root -m 0700 "$stage"
  log 'STAGE=PREFLIGHT'
  service_preflight "$ACTIVE_EVIDENCE/before-health.json"

  copy_regular_input "$input_dir/manifest" "$stage/manifest" - > "$ACTIVE_EVIDENCE/manifest.sha256"
  copy_regular_input "$input_dir/manifest.sig" "$stage/manifest.sig" - > "$ACTIVE_EVIDENCE/manifest-signature.sha256"
  ssh-keygen -Y verify -f "$ALLOWED_SIGNERS" -I "$SIGNER_IDENTITY" -n "$SIGNATURE_NAMESPACE" -s "$stage/manifest.sig" < "$stage/manifest" > "$ACTIVE_EVIDENCE/signature-verification.txt"
  validate_manifest "$stage/manifest" "$commit" | tee -a "$ACTIVE_EVIDENCE/summary.log"

  manifest="$stage/manifest"
  expected_current=$(manifest_field "$manifest" expected_current)
  source_sha256=$(manifest_field "$manifest" source_sha256)
  built_sha256=$(manifest_field "$manifest" built_sha256)
  build_id=$(manifest_field "$manifest" build_id)
  esbuild_version=$(manifest_field "$manifest" esbuild_version)
  database_migration=$(manifest_field "$manifest" database_migration)
  environment_write=$(manifest_field "$manifest" environment_write)
  assert_release_policy "$database_migration" "$environment_write"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_K84" ]]; then
    environment_previous=$(read_agent_interventions_env_state)
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    environment_previous=$(read_knowledge_v2_boolean_env_state)
    assert_knowledge_v2_canary_configured | tee -a "$ACTIVE_EVIDENCE/summary.log"
  else
    environment_previous='unmodified'
  fi
  source_archive="$stage/source.tar"
  built_archive="$stage/built.tar.gz"
  release="$RELEASE_ROOT/$commit"
  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  [[ ! -e "$release" && ! -L "$release" ]]

  copy_regular_input "$input_dir/source.tar" "$source_archive" "$source_sha256" > "$ACTIVE_EVIDENCE/source.sha256"
  copy_regular_input "$input_dir/built.tar.gz" "$built_archive" "$built_sha256" > "$ACTIVE_EVIDENCE/built.sha256"
  validate_archive "$source_archive" "$stage/source.executables" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  validate_archive "$built_archive" "$stage/built.executables" | tee -a "$ACTIVE_EVIDENCE/summary.log"

  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'CURRENT_BEFORE=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'EXPECTED_CURRENT=%s\n' "$expected_current"
    printf 'SOURCE_ARCHIVE_SHA256=%s\n' "$source_sha256"
    printf 'BUILT_ARCHIVE_SHA256=%s\n' "$built_sha256"
    printf 'BUILD_ID=%s\n' "$build_id"
    printf 'DATABASE_MIGRATION=%s\n' "$database_migration"
    printf 'ENVIRONMENT_WRITE=%s\n' "$environment_write"
    printf 'ENVIRONMENT_PREVIOUS=%s\n' "$environment_previous"
  } > "$ACTIVE_EVIDENCE/PREFLIGHT.txt"

  log 'STAGE=RESTORE_POINT'
  "$BACKUP_WRAPPER" > "$ACTIVE_EVIDENCE/backup-wrapper.log" 2>&1
  grep -Fqx 'STATUS=SUCCEEDED' "$ACTIVE_EVIDENCE/backup-wrapper.log"
  systemctl is-active --quiet "$SERVICE"
  capture_base_health "$ACTIVE_EVIDENCE/after-backup-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  grep -E '^(BACKUP_PATH|RESTORE_POINT|STATUS)=' "$ACTIVE_EVIDENCE/backup-wrapper.log" > "$ACTIVE_EVIDENCE/restore-point.txt" || true

  log 'STAGE=PREPARE_RELEASE'
  install -d -o root -g "$SERVICE_GROUP" -m 0750 "$release"
  tar --no-same-owner --no-same-permissions --delay-directory-restore -xf "$source_archive" -C "$release"
  tar --no-same-owner --no-same-permissions --delay-directory-restore -xzf "$built_archive" -C "$release"
  test -s "$release/.next/BUILD_ID"
  [[ "$(cat "$release/.next/BUILD_ID")" == "$build_id" ]]
  test -r "$release/node_modules/tsx/dist/cli.mjs"
  test -r "$release/scripts/start-local-host.ts"
  chown -hR root:"$SERVICE_GROUP" "$release"
  find "$release" -xdev -type d -exec chmod 0750 {} +
  find "$release" -xdev -type f -exec chmod 0640 {} +
  repair_executable_permissions "$release" "$stage/source.executables" "$stage/built.executables" "$ACTIVE_EVIDENCE/executable-permissions.tsv" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0770 "$release/.next/cache"
  write_release_source_binding "$release" "$commit"
  write_release_marker "$release" "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"
  verify_release "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"

  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  systemctl is-active --quiet "$SERVICE"
  capture_base_health "$ACTIVE_EVIDENCE/final-precutover-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  confirmation_token=$(write_seal "$run_id" "$commit" "$expected_current" "$build_id" "$esbuild_version" "$database_migration" "$environment_write" "$environment_previous")
  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'EXPECTED_CURRENT=%s\n' "$expected_current"
    printf 'RELEASE=%s\n' "$release"
    printf 'BUILD_ID=%s\n' "$build_id"
    printf 'DATABASE_MIGRATION=%s\n' "$database_migration"
    printf 'ENVIRONMENT_WRITE=%s\n' "$environment_write"
    printf 'ENVIRONMENT_PREVIOUS=%s\n' "$environment_previous"
    printf 'RELEASE_MARKER=PASS\n'
    printf 'SERVICE_ACCESS_PRECHECK=PASS\n'
    printf 'CURRENT_AFTER=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'CUTOVER=NOT_PERFORMED\n'
    printf 'STATUS=PREPARED\n'
  } > "$ACTIVE_EVIDENCE/PREPARED.result"
  finalize_evidence
  ACTIVE_EVIDENCE=''

  printf 'PREPARED=YES\n'
  printf 'RUN_ID=%s\n' "$run_id"
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$run_id"
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  printf 'CUTOVER=NOT_PERFORMED\n'
  printf 'CUTOVER_CONFIRMATION_TOKEN=%s\n' "$confirmation_token"
}

audit_prepared() {
  local run_id=$1
  local seal
  local commit
  local expected_current
  local release
  local build_id
  local esbuild_version
  local database_migration
  local environment_write
  local audit_run_id
  local audit_root
  local audit_home
  local quality_report
  local harness_report
  local verification
  local quality_sha
  local harness_sha
  local seal_tmp

  assert_run_id "$run_id"
  assert_operations_roots
  seal="$SEAL_ROOT/$run_id.seal"
  [[ -f "$seal" && ! -L "$seal" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$seal")" == 'root:root:600' ]]
  [[ -z "$(seal_field "$seal" audit_quality_sha256)" ]]
  commit=$(seal_field "$seal" source_commit)
  expected_current=$(seal_field "$seal" expected_current)
  release=$(seal_field "$seal" release)
  build_id=$(seal_field "$seal" build_id)
  esbuild_version=$(seal_field "$seal" esbuild_version)
  database_migration=$(seal_field "$seal" database_migration)
  environment_write=$(seal_field "$seal" environment_write)
  assert_commit "$commit"
  [[ "$expected_current" =~ ^[0-9a-f]{40}$ ]]
  [[ "$release" == "$RELEASE_ROOT/$commit" ]]
  [[ "$database_migration" == "$DATABASE_MIGRATION_KV2" ]]
  [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]
  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  verify_release "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"

  audit_run_id="audit-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence audit "$audit_run_id"
  ACTIVE_COMMIT="$commit"
  log 'STAGE=CANDIDATE_MODEL_AUDIT'
  audit_root="$release/.runtime/release-audit/$audit_run_id"
  audit_home="$audit_root/home"
  quality_report="$audit_root/agent-eval.json"
  harness_report="$audit_root/agent-harness.json"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0770 "$release/.runtime/agent-eval"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0770 "$release/.runtime/agent-harness"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0770 "$release/.runtime/release-audit"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0770 "$audit_root"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0700 "$audit_home"

  runuser -u "$SERVICE_USER" -- /bin/bash -c '
    set -Eeuo pipefail
    cd "$1"
    exec env -i \
      HOME="$2" USER=lumi LOGNAME=lumi \
      PATH=/usr/sbin:/usr/bin:/sbin:/bin NODE_ENV=test \
      CHUYING_SERVICE_ENV="$3" \
      RELEASE_SOURCE_BINDING_PATH="$4" \
      LUMI_RELEASE_AUDIT_AGENT_EVAL_REPORT_PATH="$5" \
      "$6" "$1/node_modules/tsx/dist/cli.mjs" \
      "$1/scripts/evaluate-agent.ts" --restart
  ' -- "$release" "$audit_home" "$SERVICE_ENV" "$release/.lumi-source-binding.json" "$quality_report" "$RUNTIME_NODE" \
    > "$ACTIVE_EVIDENCE/agent-eval.log" 2>&1

  runuser -u "$SERVICE_USER" -- /bin/bash -c '
    set -Eeuo pipefail
    cd "$1"
    exec env -i \
      HOME="$2" USER=lumi LOGNAME=lumi \
      PATH=/usr/sbin:/usr/bin:/sbin:/bin NODE_ENV=test \
      CHUYING_SERVICE_ENV="$3" \
      RELEASE_SOURCE_BINDING_PATH="$4" \
      LUMI_RELEASE_AUDIT_AGENT_HARNESS_REPORT_PATH="$5" \
      "$6" "$1/node_modules/tsx/dist/cli.mjs" \
      "$1/scripts/run-agent-harness.ts"
  ' -- "$release" "$audit_home" "$SERVICE_ENV" "$release/.lumi-source-binding.json" "$harness_report" "$RUNTIME_NODE" \
    > "$ACTIVE_EVIDENCE/agent-harness.log" 2>&1

  verification=$(verify_candidate_quality_reports "$quality_report" "$harness_report" "$commit")
  printf '%s\n' "$verification" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  quality_sha=$(printf '%s\n' "$verification" | awk -F= '$1 == "QUALITY_REPORT_SHA256" { print $2 }')
  harness_sha=$(printf '%s\n' "$verification" | awk -F= '$1 == "HARNESS_REPORT_SHA256" { print $2 }')
  [[ "$quality_sha" =~ ^[0-9a-f]{64}$ ]]
  [[ "$harness_sha" =~ ^[0-9a-f]{64}$ ]]
  chown root:"$SERVICE_GROUP" "$quality_report" "$harness_report"
  chmod 0640 "$quality_report" "$harness_report"
  chown root:"$SERVICE_GROUP" "$audit_root"
  chmod 0750 "$audit_root"
  runuser -u "$SERVICE_USER" -- test -r "$quality_report"
  runuser -u "$SERVICE_USER" -- test -r "$harness_report"

  seal_tmp=$(mktemp "$SEAL_ROOT/.$run_id.audit.XXXXXX")
  cat "$seal" > "$seal_tmp"
  {
    printf 'audit_run_id=%s\n' "$audit_run_id"
    printf 'audit_quality_report=%s\n' "$quality_report"
    printf 'audit_quality_sha256=%s\n' "$quality_sha"
    printf 'audit_harness_report=%s\n' "$harness_report"
    printf 'audit_harness_sha256=%s\n' "$harness_sha"
  } >> "$seal_tmp"
  chown root:root "$seal_tmp"
  chmod 0600 "$seal_tmp"
  mv -f -- "$seal_tmp" "$seal"
  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'PREPARE_RUN_ID=%s\n' "$run_id"
    printf 'QUALITY_REPORT_SHA256=%s\n' "$quality_sha"
    printf 'HARNESS_REPORT_SHA256=%s\n' "$harness_sha"
    printf 'PRODUCTION_REPORTS=NOT_CHANGED\n'
    printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'STATUS=SUCCEEDED\n'
  } > "$ACTIVE_EVIDENCE/SUCCEEDED.result"
  finalize_evidence
  ACTIVE_EVIDENCE=''
  printf 'AUDIT=SUCCEEDED\n'
  printf 'RUN_ID=%s\n' "$audit_run_id"
  printf 'PREPARE_RUN_ID=%s\n' "$run_id"
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  printf 'PRODUCTION_REPORTS=NOT_CHANGED\n'
}

cutover() {
  local run_id=$1
  local confirmation_token=$2
  local seal
  local commit
  local expected_current
  local release
  local build_id
  local esbuild_version
  local database_migration
  local environment_write
  local environment_previous
  local expected_token_hash
  local actual_token_hash
  local cutover_run_id
  local link_tmp
  local audit_quality_report
  local audit_quality_sha
  local audit_harness_report
  local audit_harness_sha

  assert_run_id "$run_id"
  [[ "$confirmation_token" =~ ^[0-9a-f]{32}$ ]] || die 'CUTOVER_CONFIRMATION_TOKEN_INVALID'
  assert_operations_roots
  seal="$SEAL_ROOT/$run_id.seal"
  [[ -f "$seal" && ! -L "$seal" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$seal")" == 'root:root:600' ]]
  commit=$(seal_field "$seal" source_commit)
  expected_current=$(seal_field "$seal" expected_current)
  release=$(seal_field "$seal" release)
  build_id=$(seal_field "$seal" build_id)
  esbuild_version=$(seal_field "$seal" esbuild_version)
  database_migration=$(seal_field "$seal" database_migration)
  environment_write=$(seal_field "$seal" environment_write)
  environment_previous=$(seal_field "$seal" environment_previous)
  expected_token_hash=$(seal_field "$seal" token_sha256)
  assert_commit "$commit"
  [[ "$expected_current" =~ ^[0-9a-f]{40}$ ]]
  [[ "$release" == "$RELEASE_ROOT/$commit" ]]
  [[ "$build_id" =~ ^[A-Za-z0-9_-]{1,128}$ ]]
  [[ "$esbuild_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
  assert_release_policy "$database_migration" "$environment_write"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_NONE" ]]; then
    [[ "$environment_previous" == 'unmodified' ]]
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    [[ "$environment_previous" =~ ^(absent|true|false),(absent|true|false),(absent|true|false)$ ]]
    [[ "$(read_knowledge_v2_boolean_env_state)" == "$environment_previous" ]]
    assert_knowledge_v2_canary_configured | tee -a "$ACTIVE_EVIDENCE/summary.log"
    audit_quality_report=$(seal_field "$seal" audit_quality_report)
    audit_quality_sha=$(seal_field "$seal" audit_quality_sha256)
    audit_harness_report=$(seal_field "$seal" audit_harness_report)
    audit_harness_sha=$(seal_field "$seal" audit_harness_sha256)
    [[ "$audit_quality_report" == "$release/.runtime/release-audit/"*/agent-eval.json ]]
    [[ "$audit_harness_report" == "$release/.runtime/release-audit/"*/agent-harness.json ]]
    [[ "$audit_quality_sha" =~ ^[0-9a-f]{64}$ ]]
    [[ "$audit_harness_sha" =~ ^[0-9a-f]{64}$ ]]
    [[ -f "$audit_quality_report" && ! -L "$audit_quality_report" ]]
    [[ -f "$audit_harness_report" && ! -L "$audit_harness_report" ]]
    [[ "$(sha256sum -- "$audit_quality_report" | awk '{print $1}')" == "$audit_quality_sha" ]]
    [[ "$(sha256sum -- "$audit_harness_report" | awk '{print $1}')" == "$audit_harness_sha" ]]
    verify_candidate_quality_reports "$audit_quality_report" "$audit_harness_report" "$commit" > /dev/null
    QUALITY_REPORT_TARGET=$(service_report_target AGENT_EVAL_REPORT_PATH)
    HARNESS_REPORT_TARGET=$(service_report_target AGENT_HARNESS_REPORT_PATH)
  else
    [[ "$environment_previous" == 'absent' || "$environment_previous" == 'true' || "$environment_previous" == 'false' ]]
    [[ "$(read_agent_interventions_env_state)" == "$environment_previous" ]]
  fi
  [[ "$expected_token_hash" =~ ^[0-9a-f]{64}$ ]]
  actual_token_hash=$(printf '%s' "$confirmation_token" | sha256sum | awk '{print $1}')
  [[ "$actual_token_hash" == "$expected_token_hash" ]]

  cutover_run_id="cutover-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence cutover "$cutover_run_id"
  ACTIVE_COMMIT="$commit"
  log 'STAGE=PREFLIGHT'
  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  CURRENT_BEFORE=$(readlink -f "$CURRENT_LINK")
  service_preflight "$ACTIVE_EVIDENCE/before-cutover-health.json"
  verify_release "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"

  CUTOVER_STARTED=true
  log 'STAGE=CUTOVER'
  systemctl stop "$SERVICE"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_K84" ]]; then
    ENVIRONMENT_PREVIOUS="$environment_previous"
    ENVIRONMENT_POLICY_ACTIVE="$environment_write"
    ENVIRONMENT_CHANGED=true
    write_agent_interventions_env_state true
    printf 'ENVIRONMENT_WRITE=SUCCEEDED\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    ENVIRONMENT_PREVIOUS="$environment_previous"
    ENVIRONMENT_POLICY_ACTIVE="$environment_write"
    ENVIRONMENT_CHANGED=true
    write_knowledge_v2_boolean_env_state 'true,true,false'
    printf 'ENVIRONMENT_WRITE=SUCCEEDED\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"
  fi
  if [[ "$database_migration" == "$DATABASE_MIGRATION_K84" ]]; then
    log 'STAGE=DATABASE_MIGRATION'
    run_k84_database_migration "$release" > "$ACTIVE_EVIDENCE/database-migration.log" 2>&1
    MIGRATION_APPLIED=true
    verify_k84_database_migration "$release" | tee -a "$ACTIVE_EVIDENCE/database-migration.log" "$ACTIVE_EVIDENCE/summary.log"
  elif [[ "$database_migration" == "$DATABASE_MIGRATION_KV2" ]]; then
    log 'STAGE=KNOWLEDGE_V2_DATABASE_ACTIVATION'
    run_knowledge_v2_database_activation "$release" "$commit" > "$ACTIVE_EVIDENCE/database-migration.log" 2>&1
    MIGRATION_APPLIED=true
    verify_knowledge_v2_database_activation "$release" | tee -a "$ACTIVE_EVIDENCE/database-migration.log" "$ACTIVE_EVIDENCE/summary.log"
  fi
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    log 'STAGE=QUALITY_REPORT_PROMOTION'
    QUALITY_REPORT_BACKUP="$ACTIVE_EVIDENCE/agent-eval.previous"
    HARNESS_REPORT_BACKUP="$ACTIVE_EVIDENCE/agent-harness.previous"
    backup_report_target "$QUALITY_REPORT_TARGET" agent-eval
    backup_report_target "$HARNESS_REPORT_TARGET" agent-harness
    QUALITY_REPORT_PREVIOUS=$(cat "$ACTIVE_EVIDENCE/agent-eval.previous-state")
    HARNESS_REPORT_PREVIOUS=$(cat "$ACTIVE_EVIDENCE/agent-harness.previous-state")
    QUALITY_REPORTS_CHANGED=true
    promote_report_file "$audit_quality_report" "$QUALITY_REPORT_TARGET" "$audit_quality_sha"
    promote_report_file "$audit_harness_report" "$HARNESS_REPORT_TARGET" "$audit_harness_sha"
    printf 'QUALITY_REPORT_PROMOTION=SUCCEEDED\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"
  fi
  link_tmp="$CURRENT_LINK.$cutover_run_id.new"
  [[ ! -e "$link_tmp" && ! -L "$link_tmp" ]]
  ln -s "$release" "$link_tmp"
  mv -Tf -- "$link_tmp" "$CURRENT_LINK"
  [[ "$(readlink -f "$CURRENT_LINK")" == "$release" ]]
  systemctl start "$SERVICE"
  systemctl is-active --quiet "$SERVICE"
  wait_for_health "$ACTIVE_EVIDENCE/new-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  local student_temporary="$ACTIVE_EVIDENCE/student.html.tmp"
  local student_status
  student_status=$(curl -fsS --max-time 30 -o "$student_temporary" -w '%{http_code}' http://127.0.0.1:3100/student)
  [[ "$student_status" == '200' ]]
  mv -f -- "$student_temporary" "$ACTIVE_EVIDENCE/student.html"
  printf 'STUDENT_HTTP_STATUS=%s\n' "$student_status" >> "$ACTIVE_EVIDENCE/summary.log"

  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'CURRENT_BEFORE=%s\n' "$CURRENT_BEFORE"
    printf 'CURRENT_AFTER=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'DATABASE_MIGRATION=%s\n' "$database_migration"
    printf 'ENVIRONMENT_WRITE=%s\n' "$environment_write"
    printf 'ENVIRONMENT_PREVIOUS=%s\n' "$environment_previous"
    if [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
      printf 'ENVIRONMENT_CURRENT=%s\n' "$(read_knowledge_v2_boolean_env_state)"
      printf 'KNOWLEDGE_V2_CANARY_COUNT=%s\n' "$(knowledge_v2_canary_count)"
    else
      printf 'ENVIRONMENT_CURRENT=%s\n' "$(read_agent_interventions_env_state)"
    fi
    printf 'STUDENT_SMOKE=PASS\n'
    printf 'ROLLBACK=NOT_NEEDED\n'
    printf 'STATUS=SUCCEEDED\n'
  } > "$ACTIVE_EVIDENCE/SUCCEEDED.result"
  rm -f -- "$seal"
  finalize_evidence
  ACTIVE_EVIDENCE=''

  printf 'CUTOVER=SUCCEEDED\n'
  printf 'RUN_ID=%s\n' "$cutover_run_id"
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$cutover_run_id"
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  printf 'STUDENT_SMOKE=PASS\n'
}

backup() {
  local run_id="backup-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  assert_operations_roots
  make_evidence backup "$run_id"
  log 'STAGE=RESTORE_POINT'
  service_preflight "$ACTIVE_EVIDENCE/before-backup-health.json"
  "$BACKUP_WRAPPER" > "$ACTIVE_EVIDENCE/backup-wrapper.log" 2>&1
  grep -Fqx 'STATUS=SUCCEEDED' "$ACTIVE_EVIDENCE/backup-wrapper.log"
  systemctl is-active --quiet "$SERVICE"
  capture_base_health "$ACTIVE_EVIDENCE/after-backup-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  grep -E '^(BACKUP_PATH|RESTORE_POINT|STATUS)=' "$ACTIVE_EVIDENCE/backup-wrapper.log" > "$ACTIVE_EVIDENCE/restore-point.txt" || true
  {
    printf 'STATUS=SUCCEEDED\n'
    printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  } > "$ACTIVE_EVIDENCE/SUCCEEDED.result"
  finalize_evidence
  ACTIVE_EVIDENCE=''
  printf 'BACKUP=SUCCEEDED\n'
  printf 'RUN_ID=%s\n' "$run_id"
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$run_id"
}

status() {
  assert_operations_roots
  [[ -L "$CURRENT_LINK" ]]
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  systemctl is-active --quiet "$SERVICE"
  printf 'SERVICE=ACTIVE\n'
  [[ -f "$SERVICE_ENV" && ! -L "$SERVICE_ENV" ]]
  runuser -u "$SERVICE_USER" -- test -r "$SERVICE_ENV"
  printf 'SERVICE_ENV_READABLE_BY_LUMI=PASS\n'
  printf 'AGENT_INTERVENTIONS_ENV=%s\n' "$(read_agent_interventions_env_state)"
  printf 'KNOWLEDGE_V2_ENV=%s\n' "$(read_knowledge_v2_boolean_env_state)"
  printf 'KNOWLEDGE_V2_CANARY_COUNT=%s\n' "$(knowledge_v2_canary_count)"
  printf 'K84_RELEASE_POLICY=AVAILABLE\n'
  printf 'KNOWLEDGE_V2_RELEASE_POLICY=AVAILABLE\n'
  status_health
}

main() {
  assert_root
  exec 9>"$LOCK_FILE"
  flock -n 9 || die 'ANOTHER_LUMI_RELEASE_OPERATION_IS_RUNNING'

  case "${1:-}" in
    status)
      [[ "$#" -eq 1 ]] || die 'STATUS_TAKES_NO_ARGUMENTS'
      status
      ;;
    backup)
      [[ "$#" -eq 1 ]] || die 'BACKUP_TAKES_NO_ARGUMENTS'
      backup
      ;;
    prepare)
      [[ "$#" -eq 2 ]] || die 'PREPARE_REQUIRES_COMMIT'
      prepare "$2"
      ;;
    audit)
      [[ "$#" -eq 2 ]] || die 'AUDIT_REQUIRES_PREPARE_RUN_ID'
      audit_prepared "$2"
      ;;
    cutover)
      [[ "$#" -eq 3 ]] || die 'CUTOVER_REQUIRES_RUN_ID_AND_TOKEN'
      cutover "$2" "$3"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
