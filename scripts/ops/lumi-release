run_k84_database_migration() {
  local release=$1
  [[ -d "$release" && ! -L "$release" ]]

  runuser -u "$SERVICE_USER" -- /bin/bash -c '
    set -Eeuo pipefail
    set -a
    . "$1"
    set +a
    export NODE_ENV=production
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin
    unset BASH_ENV ENV GIT_DIR GIT_WORK_TREE NODE_OPTIONS npm_config_userconfig
    cd "$2"
    exec "$3" "$2/node_modules/tsx/dist/cli.mjs" "$2/lib/db/migrate.ts"
  ' -- "$SERVICE_ENV" "$release" "$RUNTIME_NODE"
}

verify_k84_database_migration() {
  local release=$1
  local verifier
  [[ -d "$release" && ! -L "$release" ]]
  verifier='
const Database = require(process.argv[1]);
const database = new Database(process.env.DATABASE_PATH, { readonly: true, fileMustExist: true });
const required = [
  ["table", "agent_run_interventions"],
  ["index", "agent_run_interventions_student_key_unique"],
  ["index", "agent_run_interventions_task_sequence_unique"],
  ["index", "agent_run_interventions_message_unique"],
  ["index", "agent_run_interventions_next_run_unique"],
  ["index", "agent_run_interventions_task_status_idx"],
  ["trigger", "agent_run_interventions_owner_insert_guard"],
  ["trigger", "agent_run_interventions_owner_update_guard"],
];
for (const [type, name] of required) {
  const row = database.prepare("SELECT 1 present FROM sqlite_master WHERE type=? AND name=?").get(type, name);
  if (!row) throw new Error("K84_MIGRATION_OBJECT_MISSING");
}

const latest = database.prepare("SELECT max(created_at) createdAt FROM __drizzle_migrations").get();
if (!latest || Number(latest.createdAt) < 1785243398751) throw new Error("K84_MIGRATION_JOURNAL_MISSING");
if (database.pragma("foreign_key_check").length > 0) throw new Error("K84_MIGRATION_FOREIGN_KEY_FAILURE");
database.close();
process.stdout.write("K84_MIGRATION_VERIFY=PASS\\n");
'

  runuser -u "$SERVICE_USER" -- /bin/bash -c '
    set -Eeuo pipefail
    set -a
    . "$1"
    set +a
    export NODE_ENV=production
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin
    unset BASH_ENV ENV GIT_DIR GIT_WORK_TREE NODE_OPTIONS npm_config_userconfig
    cd "$2"
    exec "$3" -e "$4" "$2/node_modules/better-sqlite3"
  ' -- "$SERVICE_ENV" "$release" "$RUNTIME_NODE" "$verifier"
}

run_knowledge_v2_database_activation() {
  local release=$1
  local commit=$2
  [[ -d "$release" && ! -L "$release" ]]
  assert_commit "$commit"

  runuser -u "$SERVICE_USER" -- /bin/bash -c '
    set -Eeuo pipefail
    set -a
    . "$1"
    set +a
    export CHUYING_SERVICE_ENV="$1"
    export NODE_ENV=production
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin
    unset BASH_ENV ENV GIT_DIR GIT_WORK_TREE NODE_OPTIONS npm_config_userconfig
    cd "$2"
    exec "$3" "$2/node_modules/tsx/dist/cli.mjs" \
      "$2/scripts/activate-knowledge-v2-production-generation.ts" \
      --expected-commit "$4"
  ' -- "$SERVICE_ENV" "$release" "$RUNTIME_NODE" "$commit"
}

verify_knowledge_v2_database_activation() {
  local release=$1
  local verifier
  [[ -d "$release" && ! -L "$release" ]]
  verifier='
const Database = require(process.argv[1]);
const database = new Database(process.env.DATABASE_PATH, { readonly: true, fileMustExist: true });
database.pragma("query_only = ON");
const count = (table) => database.prepare(`SELECT count(*) count FROM ${table}`).get().count;
const expected = {
  knowledge_documents_v2: 808,
  knowledge_nodes_v2: 5164,
  knowledge_assets_v2: 156,
  knowledge_index_entries_v2: 5164,
  knowledge_active_corpus_v2: 1,
  knowledge_active_index_bundle_v2: 1,
};
