write_failure() {
  [[ -n "$ACTIVE_EVIDENCE" && -d "$ACTIVE_EVIDENCE" ]] || return 0
  {
    printf 'RUN_ID=%s\n' "$ACTIVE_RUN_ID"
    printf 'SOURCE_COMMIT=%s\n' "$ACTIVE_COMMIT"
    printf 'PHASE=%s\n' "$ACTIVE_PHASE"
    printf 'STATUS=FAILED\n'
    printf 'CUTOVER_STARTED=%s\n' "$CUTOVER_STARTED"
    printf 'CURRENT_AT_FAILURE=%s\n' "$(readlink -f "$CURRENT_LINK" 2>/dev/null || printf 'UNREADABLE')"
    printf 'ROLLBACK_ATTEMPTED=%s\n' "$ROLLBACK_ATTEMPTED"
    printf 'ENVIRONMENT_CHANGED=%s\n' "$ENVIRONMENT_CHANGED"
    printf 'MIGRATION_APPLIED=%s\n' "$MIGRATION_APPLIED"
  } > "$ACTIVE_EVIDENCE/FAILED.result"
}

rollback_current() {
  [[ "$CUTOVER_STARTED" == true && "$ROLLBACK_ATTEMPTED" == false ]] || return 0
  ROLLBACK_ATTEMPTED=true
  printf 'ROLLBACK=STARTED\n' >> "$ACTIVE_EVIDENCE/summary.log"
  systemctl stop "$SERVICE" || true
  if [[ -n "$CURRENT_BEFORE" && -d "$CURRENT_BEFORE" && ! -L "$CURRENT_BEFORE" ]]; then
    local rollback_link="$CURRENT_LINK.rollback-$ACTIVE_RUN_ID.$$"
    if [[ ! -e "$rollback_link" && ! -L "$rollback_link" ]]; then
      ln -s "$CURRENT_BEFORE" "$rollback_link" && mv -Tf -- "$rollback_link" "$CURRENT_LINK" || true
    fi
  fi
  if [[ "$ENVIRONMENT_CHANGED" == true ]]; then
    local environment_restored=false
    if [[ "$ENVIRONMENT_POLICY_ACTIVE" == "$ENVIRONMENT_WRITE_K84" ]] \
      && write_agent_interventions_env_state "$ENVIRONMENT_PREVIOUS"; then
      environment_restored=true
    elif [[ "$ENVIRONMENT_POLICY_ACTIVE" == "$ENVIRONMENT_WRITE_KV2" ]] \
      && write_knowledge_v2_boolean_env_state "$ENVIRONMENT_PREVIOUS"; then
      environment_restored=true
    fi
    if [[ "$environment_restored" == true ]]; then
      printf 'ROLLBACK_ENVIRONMENT=RESTORED_%s\n' "$ENVIRONMENT_PREVIOUS" >> "$ACTIVE_EVIDENCE/summary.log"
    else
      printf 'ROLLBACK_ENVIRONMENT=RESTORE_FAILED\n' >> "$ACTIVE_EVIDENCE/summary.log"
    fi
  fi
  if [[ "$MIGRATION_APPLIED" == true ]]; then
    printf 'ROLLBACK_DATABASE=ADDITIVE_SCHEMA_RETAINED\n' >> "$ACTIVE_EVIDENCE/summary.log"
  fi
  if [[ "$QUALITY_REPORTS_CHANGED" == true ]]; then
    if restore_report_target "$QUALITY_REPORT_TARGET" "$QUALITY_REPORT_PREVIOUS" "$QUALITY_REPORT_BACKUP" \
      && restore_report_target "$HARNESS_REPORT_TARGET" "$HARNESS_REPORT_PREVIOUS" "$HARNESS_REPORT_BACKUP"; then
      printf 'ROLLBACK_QUALITY_REPORTS=RESTORED\n' >> "$ACTIVE_EVIDENCE/summary.log"
    else
      printf 'ROLLBACK_QUALITY_REPORTS=RESTORE_FAILED\n' >> "$ACTIVE_EVIDENCE/summary.log"
    fi
  fi
  systemctl start "$SERVICE" || true
  if wait_for_health "$ACTIVE_EVIDENCE/rollback-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"; then
    printf 'ROLLBACK=HEALTHY\n' >> "$ACTIVE_EVIDENCE/summary.log"
  else
    printf 'ROLLBACK=HEALTH_FAILED\n' >> "$ACTIVE_EVIDENCE/summary.log"
  fi
}

on_error() {
  local status=$?
  trap - ERR
  set +e
  rollback_current
  write_failure
  finalize_evidence
  exit "$status"
}
trap on_error ERR

copy_regular_input() {
  local source=$1
  local destination=$2
  local expected_sha256=$3
  python3 - "$source" "$destination" "$expected_sha256" <<'PY'
import hashlib
import hmac
import os
import stat
import sys

source, destination, expected = sys.argv[1:]
source_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
destination_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
source_fd = os.open(source, source_flags)
try:
    source_stat = os.fstat(source_fd)
    if not stat.S_ISREG(source_stat.st_mode):
        raise SystemExit("INPUT_NOT_REGULAR_FILE")
    destination_fd = os.open(destination, destination_flags, 0o600)
    try:
        digest = hashlib.sha256()
        while True:
            block = os.read(source_fd, 1024 * 1024)
            if not block:
                break
            digest.update(block)
            view = memoryview(block)
            while view:
                written = os.write(destination_fd, view)
                view = view[written:]
        os.fsync(destination_fd)
        os.fchmod(destination_fd, 0o600)
    finally:
        os.close(destination_fd)
finally:
    os.close(source_fd)

actual = digest.hexdigest()
if expected != "-" and not hmac.compare_digest(actual, expected):
    raise SystemExit("INPUT_SHA256_MISMATCH")
print(actual)
PY
}

validate_archive() {
  local archive=$1
  local executable_list=$2
  python3 - "$archive" "$executable_list" <<'PY'
import posixpath
from pathlib import PurePosixPath
import sys
import tarfile

archive = sys.argv[1]
executable_list = sys.argv[2]

def reject(reason):
    raise SystemExit(reason)

def normalized_path(value, label):
    if not value or "\x00" in value or "\n" in value or "\r" in value:
        reject(f"UNSAFE_{label}_NAME")
    if value.startswith("/"):
        reject(f"ABSOLUTE_{label}_PATH")
    normalized = posixpath.normpath(value)
    while normalized.startswith("./"):
        normalized = normalized[2:]
    if normalized in ("", "."):
        return ""
    if normalized == ".." or normalized.startswith("../"):
        reject(f"PATH_TRAVERSAL_{label}")
    if PurePosixPath(normalized).is_absolute():
        reject(f"ABSOLUTE_{label}_PATH")
    return normalized

def validate_symlink(path, target):
    if not target or "\x00" in target or "\n" in target or "\r" in target:
        reject("UNSAFE_SYMLINK_TARGET")
    if target.startswith("/"):
        reject("ABSOLUTE_SYMLINK_TARGET")
    resolved = posixpath.normpath(posixpath.join(posixpath.dirname(path), target))
    if resolved == ".." or resolved.startswith("../") or resolved.startswith("/"):
        reject("SYMLINK_ESCAPES_RELEASE")

seen = set()
executables = set()
with tarfile.open(archive, "r:*") as bundle:
    for member in bundle:
        path = normalized_path(member.name, "MEMBER")
        if not path:
            if member.isdir():
                continue
            reject("EMPTY_MEMBER_PATH")
        if path in seen and not member.isdir():
            reject(f"DUPLICATE_ARCHIVE_MEMBER:{path}")
        seen.add(path)
        if path.startswith(".env") and "/" not in path and path != ".env.example":
            reject("ROOT_ENV_FILE_REJECTED")
        if member.isdir():
            continue
        if member.isfile():
            if member.mode & 0o111:
                executables.add(path)
            continue
        if member.issym():
            validate_symlink(path, member.linkname)
            continue
        if member.islnk():
            target = normalized_path(member.linkname, "HARDLINK")
            if not target:
                reject("UNSAFE_HARDLINK_TARGET")
            continue
        reject(f"UNSUPPORTED_ARCHIVE_MEMBER:{path}")

with open(executable_list, "w", encoding="utf-8") as handle:
    for path in sorted(executables):
        handle.write(path + "\n")
print(f"ARCHIVE_VALID=PASS members={len(seen)} executables={len(executables)}")
PY
}

repair_executable_permissions() {
  local release=$1
  local first_list=$2
  local second_list=$3
  local report=$4
  python3 - "$release" "$first_list" "$second_list" "$report" <<'PY'
from pathlib import Path
import stat
import sys

release = Path(sys.argv[1]).resolve(strict=True)
lists = [Path(sys.argv[2]), Path(sys.argv[3])]
report = Path(sys.argv[4])
paths = set()
for listing in lists:
    paths.update(line.strip() for line in listing.read_text(encoding="utf-8").splitlines() if line.strip())

with report.open("w", encoding="utf-8") as output:
    output.write("relative_path\tmode_before\tmode_after\n")
    for relative in sorted(paths):
        candidate = release / relative
        if candidate.is_symlink():
            raise SystemExit(f"EXECUTABLE_IS_SYMLINK:{relative}")
        resolved = candidate.resolve(strict=True)
        if release not in resolved.parents or not candidate.is_file():
            raise SystemExit(f"UNSAFE_EXECUTABLE_MEMBER:{relative}")
        before = stat.S_IMODE(candidate.stat().st_mode)
        candidate.chmod(0o750)
        after = stat.S_IMODE(candidate.stat().st_mode)
        if after != 0o750:
            raise SystemExit(f"EXECUTABLE_MODE_REPAIR_FAILED:{relative}")
        output.write(f"{relative}\t{before:04o}\t{after:04o}\n")

print(f"EXECUTABLE_FILE_COUNT={len(paths)}")
PY
}

