  [[ "$(stat -c '%U:%G:%a' -- "$seal")" == 'root:root:600' ]]
  [[ -z "$(seal_field "$seal" audit_quality_sha256)" ]]
  [[ "$quality_sha" =~ ^[0-9a-f]{64}$ ]]
  [[ "$harness_sha" =~ ^[0-9a-f]{64}$ ]]
  seal_tmp=$(mktemp "$SEAL_ROOT/.$run_id.audit.XXXXXX")
  cat "$seal" > "$seal_tmp"
  {
    printf 'audit_run_id=%s\n' "$audit_run_id"
    printf 'audit_quality_report=%s\n' "$quality_report"
    printf 'audit_quality_sha256=%s\n' "$quality_sha"
