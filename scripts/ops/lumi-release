#!/usr/bin/env bash
# Root-owned privilege boundary for Lumi release preparation and cutover.
#
# This program is intentionally installed outside the Git worktree. Its only
# writable inputs are signed release bundles below INPUT_ROOT. It never runs a
# user-writable shell script as root. Environment changes are restricted to
# exact allowlisted tuples, and prepare and cutover remain separate operations.

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset BASH_ENV CDPATH ENV GIT_DIR GIT_WORK_TREE NODE_OPTIONS npm_config_userconfig

readonly SERVICE='lumi-s0.service'
readonly SERVICE_USER='lumi'
readonly SERVICE_GROUP='lumi'
readonly OPERATIONS_USER='arlo'
readonly RELEASE_ROOT='/opt/lumi/releases'
readonly CURRENT_LINK='/opt/lumi/current'
readonly RUNTIME_NODE='/opt/lumi/runtime/node-v22.23.1/bin/node'
readonly SERVICE_ENV='/etc/lumi/lumi.env'
readonly BACKUP_WRAPPER='/usr/local/sbin/lumi-backup'
readonly INPUT_ROOT='/home/arlo/lumi-release-input'
readonly WORK_ROOT='/var/lib/lumi/release-operations'
readonly SEAL_ROOT='/var/lib/lumi/release-operations/prepared'
readonly EVIDENCE_ROOT='/home/arlo/lumi-deploy-attempts/deploy-attempts'
readonly ALLOWED_SIGNERS='/etc/lumi/lumi-release-allowed-signers'
readonly SIGNER_IDENTITY='lumi-release'
readonly SIGNATURE_NAMESPACE='lumi-release'
readonly ESBUILD_REL='node_modules/.pnpm/@esbuild+linux-x64@0.28.1/node_modules/@esbuild/linux-x64/bin/esbuild'
readonly LOCK_FILE='/run/lock/lumi-release.lock'
readonly HEALTH_STARTUP_TIMEOUT_SECONDS=180
readonly HEALTH_RETRY_CURL_TIMEOUT_SECONDS=3
readonly DATABASE_MIGRATION_NONE='not-required'
readonly DATABASE_MIGRATION_K84='agent-interventions-0048-additive'
readonly DATABASE_MIGRATION_KV2='knowledge-v2-0050-additive'
readonly ENVIRONMENT_WRITE_NONE='not-requested'
readonly ENVIRONMENT_WRITE_K84='enable-agent-interventions'
readonly ENVIRONMENT_WRITE_KV2='enable-knowledge-v2-text'

ACTIVE_EVIDENCE=''
ACTIVE_RUN_ID=''
ACTIVE_COMMIT=''
ACTIVE_PHASE=''
CURRENT_BEFORE=''
CUTOVER_STARTED=false
ROLLBACK_ATTEMPTED=false
ENVIRONMENT_CHANGED=false
ENVIRONMENT_PREVIOUS='unmodified'
ENVIRONMENT_POLICY_ACTIVE='not-requested'
MIGRATION_APPLIED=false
QUALITY_REPORTS_CHANGED=false
QUALITY_REPORT_TARGET=''
QUALITY_REPORT_PREVIOUS='absent'
QUALITY_REPORT_BACKUP=''
HARNESS_REPORT_TARGET=''
HARNESS_REPORT_PREVIOUS='absent'
HARNESS_REPORT_BACKUP=''

usage() {
  cat <<'EOF'
Usage:
  lumi-release status
  lumi-release backup
  lumi-release prepare <40-hex-commit>
  lumi-release audit <prepare-run-id>
  lumi-release cutover <prepare-run-id> <32-hex-confirmation-token>

Signed release input layout:
  /home/arlo/lumi-release-input/<commit>/manifest
  /home/arlo/lumi-release-input/<commit>/manifest.sig
  /home/arlo/lumi-release-input/<commit>/source.tar
  /home/arlo/lumi-release-input/<commit>/built.tar.gz

The signed manifest contains exactly:
  source_commit=<40-hex-commit>
  expected_current=<40-hex-commit>
  source_sha256=<64-hex-sha256>
  built_sha256=<64-hex-sha256>
  build_id=<Next BUILD_ID>
  esbuild_version=<semver>
  database_migration=not-required|agent-interventions-0048-additive|knowledge-v2-0050-additive
  environment_write=not-requested|enable-agent-interventions|enable-knowledge-v2-text
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log() {
  if [[ -n "$ACTIVE_EVIDENCE" ]]; then
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  else
    printf '%s\n' "$*"
  fi
}

finalize_evidence() {
  [[ -n "$ACTIVE_EVIDENCE" && -d "$ACTIVE_EVIDENCE" && ! -L "$ACTIVE_EVIDENCE" ]] || return 0
  chown -hR "$OPERATIONS_USER:$OPERATIONS_USER" "$ACTIVE_EVIDENCE"
  find "$ACTIVE_EVIDENCE" -xdev -type d -exec chmod 0700 {} +
  find "$ACTIVE_EVIDENCE" -xdev -type f -exec chmod 0600 {} +
}

capture_health() {
  local destination=$1
  local request_timeout_seconds=${2:-20}
  local temporary="$destination.tmp.$$"
  if ! curl -fsS --max-time "$request_timeout_seconds" http://127.0.0.1:3100/api/health > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! python3 - "$temporary" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    payload = json.load(handle)

if payload.get("status") != "ok":
    raise SystemExit("HEALTH_STATUS_NOT_OK")
if payload.get("database", {}).get("available") is not True:
    raise SystemExit("HEALTH_DATABASE_NOT_AVAILABLE")
if payload.get("aiConfigured") is not True:
    raise SystemExit("HEALTH_AI_NOT_CONFIGURED")
if payload.get("competitionReady") is not True:
    raise SystemExit("HEALTH_COMPETITION_NOT_READY")
PY
  then
    rm -f -- "$temporary"
    return 1
  fi
  mv -f -- "$temporary" "$destination"
  printf 'HEALTH_OK\n'
}

