reconstruct_knowledge_v2_corpus_for_d27() {
  local current_release=$1
  local target_release=$2
  local repair_root=$3
  local repair_script="$repair_root/reconstruct-corpus.mts"
  [[ -d "$current_release" && ! -L "$current_release" ]]
  [[ -d "$target_release" && ! -L "$target_release" ]]
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0700 "$repair_root"
  cat > "$repair_script" <<'TS'
import { createHash } from "node:crypto";
import { createRequire } from "node:module";
import { closeSync, fsyncSync, mkdirSync, openSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";

const [currentRelease, targetRelease, repairRoot] = process.argv.slice(2);
if (!currentRelease || !targetRelease || !repairRoot || !process.env.DATABASE_PATH) {
  throw new Error("KNOWLEDGE_V2_CORPUS_REPAIR_INPUT_INVALID");
}
const manifest = JSON.parse(readFileSync(path.join(currentRelease, "runtime-manifest.json"), "utf8"));
const relative = "data/knowledge-v2/knowledge-corpus.v2.json";
const expected = manifest.files.find((file: { path?: string }) => file.path === relative);
if (!expected || typeof expected.bytes !== "number" || typeof expected.sha256 !== "string") {
  throw new Error("KNOWLEDGE_V2_CORPUS_REPAIR_MANIFEST_INVALID");
}
const corpusHash = manifest.bindings?.corpusBundleHash;
if (typeof corpusHash !== "string") throw new Error("KNOWLEDGE_V2_CORPUS_REPAIR_BINDING_INVALID");

const requireFromRelease = createRequire(path.join(currentRelease, "package.json"));
const Database = requireFromRelease("better-sqlite3") as typeof import("better-sqlite3");
const database = new Database(process.env.DATABASE_PATH, { readonly: true, fileMustExist: true });
const row = database.prepare(`
  SELECT canonical_json canonicalJson
  FROM knowledge_corpora_v2
  WHERE bundle_hash=?
`).get(corpusHash) as { canonicalJson?: string } | undefined;
database.close();
if (!row?.canonicalJson) throw new Error("KNOWLEDGE_V2_CORPUS_REPAIR_DATABASE_ROW_MISSING");

const moduleUrl = pathToFileURL(path.join(
  targetRelease,
  "lib/knowledge/knowledge-object-v2.ts",
)).href;
const { verifyKnowledgeCorpusBundleV2 } = await import(moduleUrl);
const corpus = verifyKnowledgeCorpusBundleV2(JSON.parse(row.canonicalJson));
if (corpus.bundleHash !== corpusHash) throw new Error("KNOWLEDGE_V2_CORPUS_REPAIR_BINDING_DRIFT");
const bytes = Buffer.from(`${JSON.stringify(corpus, null, 2)}\n`, "utf8");
const sha256 = createHash("sha256").update(bytes).digest("hex");
if (bytes.length !== expected.bytes || sha256 !== expected.sha256) {
  throw new Error(
    `KNOWLEDGE_V2_CORPUS_REPAIR_HASH_DRIFT:EXPECTED_BYTES=${expected.bytes}:ACTUAL_BYTES=${bytes.length}:`
    + `EXPECTED_SHA256=${expected.sha256}:ACTUAL_SHA256=${sha256}`,
  );
}
const output = path.join(repairRoot, relative);
mkdirSync(path.dirname(output), { recursive: true });
writeFileSync(output, bytes, { flag: "wx", mode: 0o600 });
const descriptor = openSync(output, "r");
try { fsyncSync(descriptor); } finally { closeSync(descriptor); }
process.stdout.write(`KNOWLEDGE_V2_CORPUS_REPAIR=PASS:${bytes.length}:${sha256}\n`);
TS
  chown root:"$SERVICE_GROUP" "$repair_script"
  chmod 0640 "$repair_script"
  runuser -u "$SERVICE_USER" -- /bin/bash -c '
    set -Eeuo pipefail
    set -a
    . "$1"
    set +a
    export CHUYING_SERVICE_ENV="$1"
    export NODE_ENV=production
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin
    unset BASH_ENV ENV GIT_DIR GIT_WORK_TREE NODE_OPTIONS npm_config_userconfig
    cd "$3"
    exec "$4" "$2/node_modules/tsx/dist/cli.mjs" "$5" "$2" "$3" "$6"
  ' -- "$SERVICE_ENV" "$current_release" "$target_release" "$RUNTIME_NODE" "$repair_script" "$repair_root"
}

inherit_knowledge_v2_runtime_for_d27() {
  local source_release=$1
  local target_release=$2
  local repair_root=$3
  python3 - "$source_release" "$target_release" "$repair_root" <<'PY'
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import stat
import sys

source = Path(sys.argv[1]).resolve(strict=True)
target = Path(sys.argv[2]).resolve(strict=True)
repair = Path(sys.argv[3]).resolve(strict=True)
corpus_path = "data/knowledge-v2/knowledge-corpus.v2.json"

def reject(reason):
    raise SystemExit(reason)

def within(root, candidate):
    try:
        candidate.relative_to(root)
        return True
    except ValueError:
        return False

def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()

def safe_file(root, relative, expected_bytes, expected_sha):
    candidate = root.joinpath(*PurePosixPath(relative).parts)
    try:
        info = candidate.lstat()
        resolved = candidate.resolve(strict=True)
    except FileNotFoundError:
        reject(f"KNOWLEDGE_V2_INHERIT_SOURCE_MISSING:{relative}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or not within(root, resolved):
        reject(f"KNOWLEDGE_V2_INHERIT_SOURCE_UNSAFE:{relative}")
    actual_sha = digest(resolved)
    if info.st_size != expected_bytes or actual_sha != expected_sha:
        reject(
            "KNOWLEDGE_V2_INHERIT_SOURCE_HASH_DRIFT:"
            f"{relative}:EXPECTED_BYTES={expected_bytes}:ACTUAL_BYTES={info.st_size}:"
            f"EXPECTED_SHA256={expected_sha}:ACTUAL_SHA256={actual_sha}"
        )
    return resolved

manifest_path = source / "runtime-manifest.json"
manifest_info = manifest_path.lstat()
if stat.S_ISLNK(manifest_info.st_mode) or not stat.S_ISREG(manifest_info.st_mode):
    reject("KNOWLEDGE_V2_INHERIT_MANIFEST_UNSAFE")
manifest_bytes = manifest_path.read_bytes()
manifest = json.loads(manifest_bytes)
files = manifest.get("files")
if not isinstance(files, list) or not 8 <= len(files) <= 100:
    reject("KNOWLEDGE_V2_INHERIT_MANIFEST_INVALID")

copied = 0
reused = 0
for item in files:
    if not isinstance(item, dict):
        reject("KNOWLEDGE_V2_INHERIT_FILE_INVALID")
    relative = item.get("path")
    expected_bytes = item.get("bytes")
    expected_sha = item.get("sha256")
    if (
        not isinstance(relative, str)
        or not isinstance(expected_bytes, int)
        or expected_bytes < 0
        or not isinstance(expected_sha, str)
        or len(expected_sha) != 64
    ):
        reject("KNOWLEDGE_V2_INHERIT_FILE_INVALID")
    pure = PurePosixPath(relative)
    if pure.is_absolute() or not pure.parts or any(part in ("", ".", "..") for part in pure.parts):
        reject("KNOWLEDGE_V2_INHERIT_PATH_UNSAFE")
    source_file = safe_file(
        repair if relative == corpus_path else source,
        relative,
        expected_bytes,
        expected_sha,
    )
    destination = target.joinpath(*pure.parts)
    destination.parent.mkdir(parents=True, exist_ok=True)
    parent = destination.parent.resolve(strict=True)
    if not within(target, parent):
        reject("KNOWLEDGE_V2_INHERIT_TARGET_ESCAPE")
    if destination.exists() or destination.is_symlink():
        destination_info = destination.lstat()
        destination_resolved = destination.resolve(strict=True)
        if destination.is_symlink() or not destination.is_file() or not within(target, destination_resolved):
            reject("KNOWLEDGE_V2_INHERIT_TARGET_UNSAFE")
        actual_sha = digest(destination_resolved)
        if destination_info.st_size == expected_bytes and actual_sha == expected_sha:
            reused += 1
            continue
        if relative != corpus_path:
            reject(f"KNOWLEDGE_V2_INHERIT_TARGET_CONFLICT:{relative}")
        destination.unlink()
    source_fd = os.open(source_file, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        destination_fd = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
        )
        try:
            while True:
                block = os.read(source_fd, 1024 * 1024)
                if not block:
                    break
                view = memoryview(block)
                while view:
                    view = view[os.write(destination_fd, view):]
            os.fsync(destination_fd)
        finally:
            os.close(destination_fd)
    finally:
        os.close(source_fd)
    safe_file(target, relative, expected_bytes, expected_sha)
    copied += 1

target_manifest = target / "runtime-manifest.json"
if target_manifest.exists() or target_manifest.is_symlink():
    if target_manifest.is_symlink() or target_manifest.read_bytes() != manifest_bytes:
        reject("KNOWLEDGE_V2_INHERIT_TARGET_MANIFEST_CONFLICT")
else:
    target_manifest.write_bytes(manifest_bytes)
    with target_manifest.open("rb") as stream:
        os.fsync(stream.fileno())

print(f"KNOWLEDGE_V2_RUNTIME_INHERIT=PASS:{len(files)}:{copied}:{reused}")
PY
}

clone_knowledge_v2_runtime_tree_for_d27() {
  local source_release=$1
  local target_release=$2
  python3 - "$source_release" "$target_release" "$SERVICE_GROUP" <<'PY'
import grp
import hashlib
import os
from pathlib import Path, PurePosixPath
import stat
import sys

source_release = Path(sys.argv[1]).resolve(strict=True)
target_release = Path(sys.argv[2]).resolve(strict=True)
expected_gid = grp.getgrnam(sys.argv[3]).gr_gid
relative_root = PurePosixPath(".runtime/knowledge-v2-linux")
source = source_release.joinpath(*relative_root.parts)
target = target_release.joinpath(*relative_root.parts)
max_files = 75000
max_bytes = 4 * 1024 * 1024 * 1024

def reject(reason):
    raise SystemExit(reason)

def within(root, candidate):
    try:
        candidate.relative_to(root)
        return True
    except ValueError:
        return False

def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()

def collect(root, label):
    if root.is_symlink() or not root.is_dir():
        reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_ROOT_UNSAFE")
    root_info = root.stat()
    if root_info.st_uid != 0 or root_info.st_mode & 0o022:
        reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_ROOT_METADATA_UNSAFE")
    entries = {}
    stack = [(PurePosixPath(), root)]
    regular_count = 0
    total_bytes = 0
    while stack:
        relative_parent, directory = stack.pop()
        for entry in sorted(os.scandir(directory), key=lambda item: item.name):
            if not entry.name or any(value in entry.name for value in ("/", "\x00", "\n", "\r")):
                reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_NAME_UNSAFE")
            relative = relative_parent / entry.name
            relative_text = relative.as_posix()
            info = entry.stat(follow_symlinks=False)
            if info.st_uid != 0:
                reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_METADATA_UNSAFE:{relative_text}")
            path = Path(entry.path)
            if stat.S_ISDIR(info.st_mode):
                if info.st_mode & 0o022:
                    reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_MODE_UNSAFE:{relative_text}")
                entries[relative_text] = ("D", 0, "", False)
                stack.append((relative, path))
            elif stat.S_ISREG(info.st_mode):
                if info.st_mode & 0o022:
                    reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_MODE_UNSAFE:{relative_text}")
                regular_count += 1
                total_bytes += info.st_size
                if regular_count > max_files or total_bytes > max_bytes:
                    reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_LIMIT_EXCEEDED")
                entries[relative_text] = (
                    "F",
                    info.st_size,
                    digest(path),
                    bool(info.st_mode & 0o111),
                )
            elif stat.S_ISLNK(info.st_mode):
                link_target = os.readlink(path)
                if (
                    not link_target
                    or os.path.isabs(link_target)
                    or any(value in link_target for value in ("\x00", "\n", "\r"))
                ):
                    reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_LINK_UNSAFE:{relative_text}")
                try:
                    resolved = path.resolve(strict=True)
                except FileNotFoundError:
                    reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_LINK_BROKEN:{relative_text}")
                if not within(root, resolved):
                    reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_LINK_ESCAPE:{relative_text}")
                entries[relative_text] = ("L", 0, link_target, False)
            else:
                reject(f"KNOWLEDGE_V2_RUNTIME_TREE_{label}_TYPE_UNSAFE:{relative_text}")
    return entries, regular_count, total_bytes

source_entries, source_files, source_bytes = collect(source, "SOURCE")
if source_files < 1:
    reject("KNOWLEDGE_V2_RUNTIME_TREE_SOURCE_EMPTY")
target.mkdir(parents=True, exist_ok=True)
if target.is_symlink() or not within(target_release, target.resolve(strict=True)):
    reject("KNOWLEDGE_V2_RUNTIME_TREE_TARGET_ROOT_UNSAFE")

for relative, expected in sorted(source_entries.items(), key=lambda item: (item[0].count("/"), item[0])):
    if expected[0] != "D":
        continue
    destination = target.joinpath(*PurePosixPath(relative).parts)
    if destination.exists() or destination.is_symlink():
        if destination.is_symlink() or not destination.is_dir():
            reject(f"KNOWLEDGE_V2_RUNTIME_TREE_TARGET_CONFLICT:{relative}")
    else:
        destination.mkdir(mode=0o750)

for relative, expected in sorted(source_entries.items()):
    kind, expected_bytes, expected_value, executable = expected
    source_path = source.joinpath(*PurePosixPath(relative).parts)
    destination = target.joinpath(*PurePosixPath(relative).parts)
    if kind == "F":
        if destination.exists() or destination.is_symlink():
            if destination.is_symlink() or not destination.is_file():
                reject(f"KNOWLEDGE_V2_RUNTIME_TREE_TARGET_CONFLICT:{relative}")
            if destination.stat().st_size != expected_bytes or digest(destination) != expected_value:
                reject(f"KNOWLEDGE_V2_RUNTIME_TREE_TARGET_HASH_DRIFT:{relative}")
        else:
            source_fd = os.open(source_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            try:
                destination_fd = os.open(
                    destination,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                    0o600,
                )
                try:
                    while True:
                        block = os.read(source_fd, 1024 * 1024)
                        if not block:
                            break
                        view = memoryview(block)
                        while view:
                            view = view[os.write(destination_fd, view):]
                    os.fsync(destination_fd)
                finally:
                    os.close(destination_fd)
            finally:
                os.close(source_fd)
        os.chown(destination, 0, expected_gid, follow_symlinks=False)
        destination.chmod(0o750 if executable else 0o640)
    elif kind == "L":
        if destination.exists() or destination.is_symlink():
            if not destination.is_symlink() or os.readlink(destination) != expected_value:
                reject(f"KNOWLEDGE_V2_RUNTIME_TREE_TARGET_LINK_DRIFT:{relative}")
        else:
            os.symlink(expected_value, destination)
        os.chown(destination, 0, expected_gid, follow_symlinks=False)

for relative, expected in sorted(source_entries.items(), reverse=True):
    if expected[0] == "D":
        destination = target.joinpath(*PurePosixPath(relative).parts)
        os.chown(destination, 0, expected_gid)
        destination.chmod(0o750)
os.chown(target, 0, expected_gid)
target.chmod(0o750)

target_entries, target_files, target_bytes = collect(target, "TARGET")
if target_entries != source_entries or target_files != source_files or target_bytes != source_bytes:
    reject("KNOWLEDGE_V2_RUNTIME_TREE_TARGET_MISMATCH")
inventory = hashlib.sha256()
for relative, value in sorted(source_entries.items()):
    inventory.update(f"{relative}\t{value[0]}\t{value[1]}\t{value[2]}\t{int(value[3])}\n".encode())
print(
    "KNOWLEDGE_V2_RUNTIME_TREE_CLONE=PASS:"
    f"{len(source_entries)}:{source_files}:{source_bytes}:{inventory.hexdigest()}"
)
PY
}

make_evidence() {
  local phase=$1
  local run_id=$2
  local path="$EVIDENCE_ROOT/$run_id"
  [[ ! -e "$path" && ! -L "$path" ]] || die 'EVIDENCE_PATH_ALREADY_EXISTS'
  install -d -o root -g root -m 0700 "$path"
  ACTIVE_EVIDENCE="$path"
  ACTIVE_RUN_ID="$run_id"
  ACTIVE_PHASE="$phase"
  printf 'RUN_ID=%s\nPHASE=%s\n' "$run_id" "$phase" > "$path/summary.log"
  fallocate -l "$FAILURE_RESERVE_BYTES" "$path/.failure-reserve"
}

release_failure_reserve() {
  [[ -n "$ACTIVE_EVIDENCE" && -d "$ACTIVE_EVIDENCE" && ! -L "$ACTIVE_EVIDENCE" ]] || return 0
  rm -f -- "$ACTIVE_EVIDENCE/.failure-reserve"
}

write_failure() {
  [[ -n "$ACTIVE_EVIDENCE" && -d "$ACTIVE_EVIDENCE" ]] || return 0
  {
    printf 'RUN_ID=%s\n' "$ACTIVE_RUN_ID"
    printf 'SOURCE_COMMIT=%s\n' "$ACTIVE_COMMIT"
    printf 'PHASE=%s\n' "$ACTIVE_PHASE"
    printf 'STATUS=FAILED\n'
    printf 'CUTOVER_STARTED=%s\n' "$CUTOVER_STARTED"
    printf 'CURRENT_AT_FAILURE=%s\n' "$(readlink -f "$CURRENT_LINK" 2>/dev/null || printf 'UNREADABLE')"
    printf 'ROLLBACK_ATTEMPTED=%s\n' "$ROLLBACK_ATTEMPTED"
    printf 'ENVIRONMENT_CHANGED=%s\n' "$ENVIRONMENT_CHANGED"
    printf 'MIGRATION_APPLIED=%s\n' "$MIGRATION_APPLIED"
  } > "$ACTIVE_EVIDENCE/FAILED.result"
}

rollback_current() {
  [[ "$CUTOVER_STARTED" == true && "$ROLLBACK_ATTEMPTED" == false ]] || return 0
  ROLLBACK_ATTEMPTED=true
  printf 'ROLLBACK=STARTED\n' >> "$ACTIVE_EVIDENCE/summary.log"
  systemctl stop "$SERVICE" || true
  if [[ -n "$CURRENT_BEFORE" && -d "$CURRENT_BEFORE" && ! -L "$CURRENT_BEFORE" ]]; then
    local rollback_link="$CURRENT_LINK.rollback-$ACTIVE_RUN_ID.$$"
    if [[ ! -e "$rollback_link" && ! -L "$rollback_link" ]]; then
      ln -s "$CURRENT_BEFORE" "$rollback_link" && mv -Tf -- "$rollback_link" "$CURRENT_LINK" || true
    fi
  fi
