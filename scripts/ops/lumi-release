verify_candidate_quality_reports() {
  local quality_report=$1
  local harness_report=$2
  local commit=$3
  python3 - "$quality_report" "$harness_report" "$commit" <<'PY'
from datetime import datetime, timezone
import hashlib
import json
import re
import sys

quality_path, harness_path, commit = sys.argv[1:]
if not re.fullmatch(r"[0-9a-f]{40}", commit):
    raise SystemExit("AUDIT_COMMIT_INVALID")

def load(path):
    with open(path, "rb") as handle:
        raw = handle.read()
    payload = json.loads(raw)
    if payload.get("sourceCommit") != commit:
        raise SystemExit("AUDIT_SOURCE_COMMIT_MISMATCH")
    if payload.get("sourceTrackedTreeClean") is not True:
        raise SystemExit("AUDIT_SOURCE_NOT_CLEAN")
    evaluated = datetime.fromisoformat(payload["evaluatedAt"].replace("Z", "+00:00"))
    age = (datetime.now(timezone.utc) - evaluated).total_seconds()
    if age < 0 or age > 3600:
        raise SystemExit("AUDIT_REPORT_NOT_FRESH")
    return payload, hashlib.sha256(raw).hexdigest()

quality, quality_sha = load(quality_path)
harness, harness_sha = load(harness_path)
if quality.get("mode") != "MODEL_ASSISTED" or quality.get("passed") is not True:
    raise SystemExit("AUDIT_AGENT_EVAL_NOT_PASSED")
if quality.get("caseCount", 0) < 30 or quality.get("passedCaseCount") != quality.get("caseCount"):
    raise SystemExit("AUDIT_AGENT_EVAL_CASES_INVALID")
if harness.get("passed") is not True:
    raise SystemExit("AUDIT_HARNESS_NOT_PASSED")
if harness.get("caseCount", 0) < 16 or harness.get("passedCaseCount") != harness.get("caseCount"):
    raise SystemExit("AUDIT_HARNESS_CASES_INVALID")
print(f"QUALITY_REPORT_SHA256={quality_sha}")
print(f"HARNESS_REPORT_SHA256={harness_sha}")
