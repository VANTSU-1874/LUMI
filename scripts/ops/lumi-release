validate_manifest() {
  local manifest=$1
  local commit=$2
  python3 - "$manifest" "$commit" <<'PY'
import re
from pathlib import Path
import sys

manifest = Path(sys.argv[1])
commit = sys.argv[2]
required = {
    "source_commit",
    "expected_current",
    "source_sha256",
    "built_sha256",
    "build_id",
    "esbuild_version",
    "database_migration",
    "environment_write",
}
values = {}
for line in manifest.read_text(encoding="utf-8").splitlines():
    if not line or "=" not in line:
        raise SystemExit("MANIFEST_LINE_INVALID")
    key, value = line.split("=", 1)
    if key not in required or key in values or not value:
        raise SystemExit("MANIFEST_FIELD_INVALID")
    values[key] = value
if set(values) != required:
    raise SystemExit("MANIFEST_FIELDS_INCOMPLETE")
if values["source_commit"] != commit:
    raise SystemExit("MANIFEST_COMMIT_MISMATCH")
if not re.fullmatch(r"[0-9a-f]{40}", values["expected_current"]):
    raise SystemExit("MANIFEST_EXPECTED_CURRENT_INVALID")
for key in ("source_sha256", "built_sha256"):
    if not re.fullmatch(r"[0-9a-f]{64}", values[key]):
        raise SystemExit("MANIFEST_SHA256_INVALID")
if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", values["build_id"]):
    raise SystemExit("MANIFEST_BUILD_ID_INVALID")
if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", values["esbuild_version"]):
    raise SystemExit("MANIFEST_ESBUILD_VERSION_INVALID")
allowed_pairs = {
    ("not-required", "not-requested"),
    ("agent-interventions-0048-additive", "enable-agent-interventions"),
    ("knowledge-v2-0050-additive", "enable-knowledge-v2-text"),
    ("inspiration-wiki-0051-0063-d27", "not-requested"),
}
if (values["database_migration"], values["environment_write"]) not in allowed_pairs:
    raise SystemExit("MANIFEST_RELEASE_POLICY_PAIR_NOT_ALLOWED")
print("MANIFEST=VALID")
PY
}

