walk(serverRoot);
const probeRequire = createRequire(
  path.join(serverRoot, "chunks", "lumi-release-alias-probe.cjs"),
);

for (const alias of [...requiredAliases].sort()) {
  if (!/^[A-Za-z0-9@._+-]+$/.test(alias)) {
    throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_NAME_INVALID");
  }
  const aliasPath = path.join(aliasRoot, alias);
  let aliasStat;
  try {
    aliasStat = fs.lstatSync(aliasPath);
  } catch (error) {
    if (error && error.code === "ENOENT") {
      throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_MISSING");
    }
    throw error;
  }
  if (!aliasStat.isSymbolicLink()) {
    throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_NOT_SYMLINK");
  }
  const target = fs.realpathSync(aliasPath);
  if (!target.startsWith(releaseModulesRoot)) {
    throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_TARGET_ESCAPE");
  }
  if (!fs.statSync(target).isDirectory()) {
    throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_TARGET_NOT_DIRECTORY");
  }
  if (!fs.statSync(path.join(target, "package.json")).isFile()) {
    throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_PACKAGE_MISSING");
  }
  const resolvedModule = fs.realpathSync(probeRequire.resolve(alias));
  if (!resolvedModule.startsWith(releaseModulesRoot)) {
    throw new Error("NEXT_EXTERNAL_MODULE_ALIAS_RESOLUTION_ESCAPE");
  }
  if (alias.startsWith("better-sqlite3-")) {
    const Database = probeRequire(alias);
    const database = new Database(":memory:");
    const row = database.prepare("select 1 as value").get();
    database.close();
    if (row.value !== 1) {
      throw new Error("NEXT_BETTER_SQLITE3_ALIAS_QUERY_FAILED");
    }
  }
  if (alias.startsWith("sharp-") && typeof probeRequire(alias) !== "function") {
    throw new Error("NEXT_SHARP_ALIAS_LOAD_FAILED");
  }
}

process.stdout.write(
  `NEXT_EXTERNAL_MODULE_ALIASES=PASS:${requiredAliases.size}\n`,
);
JS
}

