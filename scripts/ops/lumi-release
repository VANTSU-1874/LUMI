capture_service_journal() {
  local destination=$1
  local since=$2
  local until=$3
  local temporary="$destination.tmp.$$"
  local raw="$destination.raw.$$"
  journalctl -u "$SERVICE" --since "$since" --until "$until" --no-pager -o short-iso > "$raw"
  python3 - "$raw" "$temporary" <<'PY'
from collections import deque
from pathlib import Path
import re
import sys

source = Path(sys.argv[1])
destination = Path(sys.argv[2])
pattern = re.compile(
    r"(?i)\b(authorization|cookie|set-cookie|token|secret|password|api[_-]?key)\b"
    r"(\s*[:=]\s*|\s+)([^\s]+)"
)
lines = deque(maxlen=1000)
with source.open(encoding="utf-8", errors="replace") as stream:
    for raw_line in stream:
        line = pattern.sub(lambda match: f"{match.group(1)}{match.group(2)}[REDACTED]", raw_line.rstrip("\n"))
        lines.append(line[:4000])
destination.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")
PY
  rm -f -- "$raw"
  mv -f -- "$temporary" "$destination"
}

finalize_evidence() {
  [[ -n "$ACTIVE_EVIDENCE" && -d "$ACTIVE_EVIDENCE" && ! -L "$ACTIVE_EVIDENCE" ]] || return 0
  rm -f -- "$ACTIVE_EVIDENCE/.failure-reserve"
  chown -hR "$OPERATIONS_USER:$OPERATIONS_USER" "$ACTIVE_EVIDENCE"
  find "$ACTIVE_EVIDENCE" -xdev -type d -exec chmod 0700 {} +
  find "$ACTIVE_EVIDENCE" -xdev -type f -exec chmod 0600 {} +
}

capture_health() {
  local destination=$1
  local request_timeout_seconds=${2:-20}
  local temporary="$destination.tmp.$$"
  if ! curl -fsS --max-time "$request_timeout_seconds" http://127.0.0.1:3100/api/health > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! python3 - "$temporary" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    payload = json.load(handle)

if payload.get("status") != "ok":
    raise SystemExit("HEALTH_STATUS_NOT_OK")
if payload.get("database", {}).get("available") is not True:
    raise SystemExit("HEALTH_DATABASE_NOT_AVAILABLE")
if payload.get("aiConfigured") is not True:
    raise SystemExit("HEALTH_AI_NOT_CONFIGURED")
if payload.get("competitionReady") is not True:
    raise SystemExit("HEALTH_COMPETITION_NOT_READY")
PY
  then
    rm -f -- "$temporary"
    return 1
  fi
  mv -f -- "$temporary" "$destination"
  printf 'HEALTH_OK\n'
}

