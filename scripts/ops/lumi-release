  release=$(seal_field "$seal" release)
  build_id=$(seal_field "$seal" build_id)
  esbuild_version=$(seal_field "$seal" esbuild_version)
  database_migration=$(seal_field "$seal" database_migration)
  environment_write=$(seal_field "$seal" environment_write)
  assert_commit "$commit"
  [[ "$expected_current" =~ ^[0-9a-f]{40}$ ]]
  [[ "$release" == "$RELEASE_ROOT/$commit" ]]
  [[ "$database_migration" == "$DATABASE_MIGRATION_KV2" ]]
  [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]
  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  verify_release "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"

  failed_evidence="$EVIDENCE_ROOT/$audit_run_id"
  [[ -d "$failed_evidence" && ! -L "$failed_evidence" ]]
  [[ "$(realpath -e -- "$failed_evidence")" == "$failed_evidence" ]]
  [[ -f "$failed_evidence/FAILED.result" && ! -L "$failed_evidence/FAILED.result" ]]
  grep -Fqx "RUN_ID=$audit_run_id" "$failed_evidence/FAILED.result"
  grep -Fqx "SOURCE_COMMIT=$commit" "$failed_evidence/FAILED.result"
  grep -Fqx 'PHASE=audit' "$failed_evidence/FAILED.result"
  grep -Fqx 'STATUS=FAILED' "$failed_evidence/FAILED.result"
  grep -Fqx 'CUTOVER_STARTED=false' "$failed_evidence/FAILED.result"
  grep -Fqx 'ROLLBACK_ATTEMPTED=false' "$failed_evidence/FAILED.result"
  grep -Fqx 'ENVIRONMENT_CHANGED=false' "$failed_evidence/FAILED.result"
  grep -Fqx 'MIGRATION_APPLIED=false' "$failed_evidence/FAILED.result"

  audit_root="$release/.runtime/release-audit/$audit_run_id"
  [[ -d "$audit_root" && ! -L "$audit_root" ]]
  [[ "$(realpath -e -- "$audit_root")" == "$audit_root" ]]
  quality_report="$audit_root/agent-eval.json"
  harness_report="$audit_root/agent-harness.json"
  [[ -f "$quality_report" && ! -L "$quality_report" ]]
  [[ -f "$harness_report" && ! -L "$harness_report" ]]

  recovery_run_id="audit-recovery-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence audit-recovery "$recovery_run_id"
  ACTIVE_COMMIT="$commit"
  service_preflight "$ACTIVE_EVIDENCE/before-audit-recovery-health.json"
  verification=$(verify_candidate_quality_reports "$quality_report" "$harness_report" "$commit")
  printf '%s\n' "$verification" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  quality_sha=$(printf '%s\n' "$verification" | awk -F= '$1 == "QUALITY_REPORT_SHA256" { print $2 }')
  harness_sha=$(printf '%s\n' "$verification" | awk -F= '$1 == "HARNESS_REPORT_SHA256" { print $2 }')
  [[ "$quality_sha" =~ ^[0-9a-f]{64}$ ]]
  [[ "$harness_sha" =~ ^[0-9a-f]{64}$ ]]
  chown root:"$SERVICE_GROUP" "$quality_report" "$harness_report"
  chmod 0640 "$quality_report" "$harness_report"
  chown root:"$SERVICE_GROUP" "$audit_root"
  chmod 0750 "$audit_root"
  runuser -u "$SERVICE_USER" -- test -r "$quality_report"
  runuser -u "$SERVICE_USER" -- test -r "$harness_report"
  seal_audit_reports "$seal" "$run_id" "$audit_run_id" "$quality_report" "$quality_sha" "$harness_report" "$harness_sha"
  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'PREPARE_RUN_ID=%s\n' "$run_id"
    printf 'RECOVERED_AUDIT_RUN_ID=%s\n' "$audit_run_id"
    printf 'QUALITY_REPORT_SHA256=%s\n' "$quality_sha"
    printf 'HARNESS_REPORT_SHA256=%s\n' "$harness_sha"
    printf 'REPORTS_REEXECUTED=NO\n'
    printf 'PRODUCTION_REPORTS=NOT_CHANGED\n'
    printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'STATUS=SUCCEEDED\n'
  } > "$ACTIVE_EVIDENCE/SUCCEEDED.result"
  finalize_evidence
  ACTIVE_EVIDENCE=''
  printf 'AUDIT_SEAL_RECOVERED=YES\n'
  printf 'PREPARE_RUN_ID=%s\n' "$run_id"
  printf 'RECOVERED_AUDIT_RUN_ID=%s\n' "$audit_run_id"
  printf 'QUALITY_CASE_COUNT=%s\n' "$(printf '%s\n' "$verification" | awk -F= '$1 == "QUALITY_CASE_COUNT" { print $2 }')"
  printf 'HARNESS_CASE_COUNT=%s\n' "$(printf '%s\n' "$verification" | awk -F= '$1 == "HARNESS_CASE_COUNT" { print $2 }')"
  printf 'REPORTS_REEXECUTED=NO\n'
  printf 'PRODUCTION_CHANGED=NO\n'
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$recovery_run_id"
}

cutover() {
  local run_id=$1
  local confirmation_token=$2
  local seal
  local commit
  local expected_current
  local release
  local build_id
  local esbuild_version
  local database_migration
  local environment_write
  local environment_previous
  local expected_token_hash
  local actual_token_hash
  local cutover_run_id
  local link_tmp
  local audit_quality_report
  local audit_quality_sha
  local audit_harness_report
  local audit_harness_sha

  assert_run_id "$run_id"
  [[ "$confirmation_token" =~ ^[0-9a-f]{32}$ ]] || die 'CUTOVER_CONFIRMATION_TOKEN_INVALID'
  assert_operations_roots
  seal="$SEAL_ROOT/$run_id.seal"
  [[ -f "$seal" && ! -L "$seal" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$seal")" == 'root:root:600' ]]
  commit=$(seal_field "$seal" source_commit)
  expected_current=$(seal_field "$seal" expected_current)
  release=$(seal_field "$seal" release)
  build_id=$(seal_field "$seal" build_id)
  esbuild_version=$(seal_field "$seal" esbuild_version)
  database_migration=$(seal_field "$seal" database_migration)
  environment_write=$(seal_field "$seal" environment_write)
  environment_previous=$(seal_field "$seal" environment_previous)
  expected_token_hash=$(seal_field "$seal" token_sha256)
  assert_commit "$commit"
  [[ "$expected_current" =~ ^[0-9a-f]{40}$ ]]
  [[ "$release" == "$RELEASE_ROOT/$commit" ]]
  [[ "$build_id" =~ ^[A-Za-z0-9_-]{1,128}$ ]]
  [[ "$esbuild_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
  assert_release_policy "$database_migration" "$environment_write"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_NONE" ]]; then
    [[ "$environment_previous" == 'unmodified' ]]
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    [[ "$environment_previous" =~ ^(absent|true|false),(absent|true|false),(absent|true|false)$ ]]
    [[ "$(read_knowledge_v2_boolean_env_state)" == "$environment_previous" ]]
    assert_knowledge_v2_canary_configured | tee -a "$ACTIVE_EVIDENCE/summary.log"
    audit_quality_report=$(seal_field "$seal" audit_quality_report)
    audit_quality_sha=$(seal_field "$seal" audit_quality_sha256)
    audit_harness_report=$(seal_field "$seal" audit_harness_report)
    audit_harness_sha=$(seal_field "$seal" audit_harness_sha256)
    [[ "$audit_quality_report" == "$release/.runtime/release-audit/"*/agent-eval.json ]]
    [[ "$audit_harness_report" == "$release/.runtime/release-audit/"*/agent-harness.json ]]
    [[ "$audit_quality_sha" =~ ^[0-9a-f]{64}$ ]]
    [[ "$audit_harness_sha" =~ ^[0-9a-f]{64}$ ]]
    [[ -f "$audit_quality_report" && ! -L "$audit_quality_report" ]]
    [[ -f "$audit_harness_report" && ! -L "$audit_harness_report" ]]
    [[ "$(sha256sum -- "$audit_quality_report" | awk '{print $1}')" == "$audit_quality_sha" ]]
    [[ "$(sha256sum -- "$audit_harness_report" | awk '{print $1}')" == "$audit_harness_sha" ]]
    verify_candidate_quality_reports "$audit_quality_report" "$audit_harness_report" "$commit" > /dev/null
    QUALITY_REPORT_TARGET=$(service_report_target AGENT_EVAL_REPORT_PATH)
    HARNESS_REPORT_TARGET=$(service_report_target AGENT_HARNESS_REPORT_PATH)
  else
    [[ "$environment_previous" == 'absent' || "$environment_previous" == 'true' || "$environment_previous" == 'false' ]]
    [[ "$(read_agent_interventions_env_state)" == "$environment_previous" ]]
  fi
  [[ "$expected_token_hash" =~ ^[0-9a-f]{64}$ ]]
  actual_token_hash=$(printf '%s' "$confirmation_token" | sha256sum | awk '{print $1}')
  [[ "$actual_token_hash" == "$expected_token_hash" ]]

  cutover_run_id="cutover-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence cutover "$cutover_run_id"
  ACTIVE_COMMIT="$commit"
  log 'STAGE=PREFLIGHT'
  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  CURRENT_BEFORE=$(readlink -f "$CURRENT_LINK")
  service_preflight "$ACTIVE_EVIDENCE/before-cutover-health.json"
  verify_release "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"

  CUTOVER_STARTED=true
  log 'STAGE=CUTOVER'
  systemctl stop "$SERVICE"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_K84" ]]; then
    ENVIRONMENT_PREVIOUS="$environment_previous"
    ENVIRONMENT_POLICY_ACTIVE="$environment_write"
    ENVIRONMENT_CHANGED=true
    write_agent_interventions_env_state true
    printf 'ENVIRONMENT_WRITE=SUCCEEDED\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    ENVIRONMENT_PREVIOUS="$environment_previous"
    ENVIRONMENT_POLICY_ACTIVE="$environment_write"
    ENVIRONMENT_CHANGED=true
    write_knowledge_v2_boolean_env_state 'true,true,false'
    printf 'ENVIRONMENT_WRITE=SUCCEEDED\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"
  fi
  if [[ "$database_migration" == "$DATABASE_MIGRATION_K84" ]]; then
    log 'STAGE=DATABASE_MIGRATION'
    run_k84_database_migration "$release" > "$ACTIVE_EVIDENCE/database-migration.log" 2>&1
    MIGRATION_APPLIED=true
    verify_k84_database_migration "$release" | tee -a "$ACTIVE_EVIDENCE/database-migration.log" "$ACTIVE_EVIDENCE/summary.log"
  elif [[ "$database_migration" == "$DATABASE_MIGRATION_KV2" ]]; then
    log 'STAGE=KNOWLEDGE_V2_DATABASE_ACTIVATION'
    run_knowledge_v2_database_activation "$release" "$commit" > "$ACTIVE_EVIDENCE/database-migration.log" 2>&1
    MIGRATION_APPLIED=true
    verify_knowledge_v2_database_activation "$release" | tee -a "$ACTIVE_EVIDENCE/database-migration.log" "$ACTIVE_EVIDENCE/summary.log"
  elif [[ "$database_migration" == "$DATABASE_MIGRATION_INSPIRATION_D27" ]]; then
    log 'STAGE=INSPIRATION_WIKI_D27_RELEASE'
    run_inspiration_wiki_d27_release "$release" > "$ACTIVE_EVIDENCE/database-migration.log" 2>&1
    MIGRATION_APPLIED=true
    verify_inspiration_wiki_d27_release "$release" | tee -a "$ACTIVE_EVIDENCE/database-migration.log" "$ACTIVE_EVIDENCE/summary.log"
  fi
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    log 'STAGE=QUALITY_REPORT_PROMOTION'
    QUALITY_REPORT_BACKUP="$ACTIVE_EVIDENCE/agent-eval.previous"
    HARNESS_REPORT_BACKUP="$ACTIVE_EVIDENCE/agent-harness.previous"
    backup_report_target "$QUALITY_REPORT_TARGET" agent-eval
    backup_report_target "$HARNESS_REPORT_TARGET" agent-harness
    QUALITY_REPORT_PREVIOUS=$(cat "$ACTIVE_EVIDENCE/agent-eval.previous-state")
    HARNESS_REPORT_PREVIOUS=$(cat "$ACTIVE_EVIDENCE/agent-harness.previous-state")
    QUALITY_REPORTS_CHANGED=true
    promote_report_file "$audit_quality_report" "$QUALITY_REPORT_TARGET" "$audit_quality_sha"
    promote_report_file "$audit_harness_report" "$HARNESS_REPORT_TARGET" "$audit_harness_sha"
    printf 'QUALITY_REPORT_PROMOTION=SUCCEEDED\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"
  fi
  link_tmp="$CURRENT_LINK.$cutover_run_id.new"
  [[ ! -e "$link_tmp" && ! -L "$link_tmp" ]]
  ln -s "$release" "$link_tmp"
  mv -Tf -- "$link_tmp" "$CURRENT_LINK"
  [[ "$(readlink -f "$CURRENT_LINK")" == "$release" ]]
  systemctl start "$SERVICE"
  systemctl is-active --quiet "$SERVICE"
  if [[ "$database_migration" == "$DATABASE_MIGRATION_KV2" || "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    wait_for_health "$ACTIVE_EVIDENCE/new-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
    printf 'CUTOVER_HEALTH_GATE=COMPETITION_READY\n' >> "$ACTIVE_EVIDENCE/summary.log"
  else
    wait_for_base_health "$ACTIVE_EVIDENCE/new-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
    printf 'CUTOVER_HEALTH_GATE=BASE\n' >> "$ACTIVE_EVIDENCE/summary.log"
  fi
  local student_headers="$ACTIVE_EVIDENCE/student.headers"
  local student_temporary="$ACTIVE_EVIDENCE/student.html.tmp"
  local student_location=''
  local student_smoke_mode=''
  local student_status
  student_status=$(curl -sS --max-time 30 -D "$student_headers" -o "$student_temporary" -w '%{http_code}' http://127.0.0.1:3100/student)
  if [[ "$student_status" == '200' ]]; then
    student_smoke_mode='WORKSPACE_200'
  elif [[ "$student_status" == '307' ]]; then
    student_location=$(awk 'BEGIN { IGNORECASE=1 } /^location:/ { sub(/^[^:]*:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit }' "$student_headers")
    [[ "$student_location" == '/login?returnTo=%2Fstudent' ]]
    local login_status
    login_status=$(curl -fsS --max-time 30 -o "$ACTIVE_EVIDENCE/login.html" -w '%{http_code}' "http://127.0.0.1:3100$student_location")
    [[ "$login_status" == '200' ]]
    student_smoke_mode='AUTH_REDIRECT_307_LOGIN_200'
    printf 'STUDENT_LOGIN_HTTP_STATUS=%s\n' "$login_status" >> "$ACTIVE_EVIDENCE/summary.log"
  else
    return 1
  fi
  mv -f -- "$student_temporary" "$ACTIVE_EVIDENCE/student.html"
  printf 'STUDENT_HTTP_STATUS=%s\n' "$student_status" >> "$ACTIVE_EVIDENCE/summary.log"
  printf 'STUDENT_SMOKE_MODE=%s\n' "$student_smoke_mode" >> "$ACTIVE_EVIDENCE/summary.log"

  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'CURRENT_BEFORE=%s\n' "$CURRENT_BEFORE"
    printf 'CURRENT_AFTER=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'DATABASE_MIGRATION=%s\n' "$database_migration"
    printf 'ENVIRONMENT_WRITE=%s\n' "$environment_write"
    printf 'ENVIRONMENT_PREVIOUS=%s\n' "$environment_previous"
    if [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
      printf 'ENVIRONMENT_CURRENT=%s\n' "$(read_knowledge_v2_boolean_env_state)"
      printf 'KNOWLEDGE_V2_CANARY_COUNT=%s\n' "$(knowledge_v2_canary_count)"
    else
      printf 'ENVIRONMENT_CURRENT=%s\n' "$(read_agent_interventions_env_state)"
    fi
    printf 'STUDENT_SMOKE=PASS\n'
    printf 'ROLLBACK=NOT_NEEDED\n'
    printf 'STATUS=SUCCEEDED\n'
  } > "$ACTIVE_EVIDENCE/SUCCEEDED.result"
  rm -f -- "$seal" "$SEAL_ROOT/$run_id.token"
  finalize_evidence
  ACTIVE_EVIDENCE=''

  printf 'CUTOVER=SUCCEEDED\n'
  printf 'RUN_ID=%s\n' "$cutover_run_id"
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$cutover_run_id"
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  printf 'STUDENT_SMOKE=PASS\n'
}

