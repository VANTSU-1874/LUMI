wait_for_health() {
  local destination=$1
  local timeout_seconds=${2:-$HEALTH_STARTUP_TIMEOUT_SECONDS}
  local deadline=$((SECONDS + timeout_seconds))
  local attempts=0

  while (( SECONDS < deadline )); do
    attempts=$((attempts + 1))
    if capture_health "$destination" "$HEALTH_RETRY_CURL_TIMEOUT_SECONDS" >/dev/null 2>&1; then
      printf 'HEALTH_OK\n'
      printf 'HEALTH_READY_ATTEMPTS=%s\n' "$attempts"
      return 0
    fi
    sleep 1
  done

  printf 'HEALTH_WAIT_TIMEOUT_SECONDS=%s\n' "$timeout_seconds" >&2
  return 1
}

status_health() {
  curl -fsS --max-time 20 http://127.0.0.1:3100/api/health | python3 -c '
import json
import sys

payload = json.load(sys.stdin)
if payload.get("status") != "ok":
    raise SystemExit("HEALTH_STATUS_NOT_OK")
if payload.get("database", {}).get("available") is not True:
    raise SystemExit("HEALTH_DATABASE_NOT_AVAILABLE")
if payload.get("aiConfigured") is not True:
    raise SystemExit("HEALTH_AI_NOT_CONFIGURED")
print("HEALTH_OK")
print("COMPETITION_READY=" + ("true" if payload.get("competitionReady") is True else "false"))
'
}

service_preflight() {
  local health_destination=$1
  [[ -x "$RUNTIME_NODE" ]]
  [[ -x "$BACKUP_WRAPPER" ]]
  [[ -f "$SERVICE_ENV" && ! -L "$SERVICE_ENV" ]]
  runuser -u "$SERVICE_USER" -- test -r "$SERVICE_ENV"
  systemctl is-active --quiet "$SERVICE"
  capture_base_health "$health_destination" | tee -a "$ACTIVE_EVIDENCE/summary.log"
}

assert_root() {
  [[ "$EUID" -eq 0 ]] || die 'ROOT_REQUIRED'
}

assert_commit() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || die 'COMMIT_MUST_BE_40_LOWERCASE_HEX'
}

assert_run_id() {
  [[ "$1" =~ ^prepare-[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]] || die 'PREPARE_RUN_ID_INVALID'
}

assert_operations_roots() {
  [[ -d "$INPUT_ROOT" && ! -L "$INPUT_ROOT" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$INPUT_ROOT")" == "$OPERATIONS_USER:$OPERATIONS_USER:700" ]]
  [[ -d "$WORK_ROOT" && ! -L "$WORK_ROOT" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$WORK_ROOT")" == 'root:root:700' ]]
  [[ -d "$SEAL_ROOT" && ! -L "$SEAL_ROOT" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$SEAL_ROOT")" == 'root:root:700' ]]
  [[ -d "$EVIDENCE_ROOT" && ! -L "$EVIDENCE_ROOT" ]]
  [[ -f "$ALLOWED_SIGNERS" && ! -L "$ALLOWED_SIGNERS" ]]
  [[ "$(stat -c '%U:%G:%a' -- "$ALLOWED_SIGNERS")" == 'root:root:644' ]]
}

assert_release_policy() {
  local database_migration=$1
  local environment_write=$2
  if [[ "$database_migration" == "$DATABASE_MIGRATION_NONE" && "$environment_write" == "$ENVIRONMENT_WRITE_NONE" ]]; then
    return 0
  fi
  if [[ "$database_migration" == "$DATABASE_MIGRATION_K84" && "$environment_write" == "$ENVIRONMENT_WRITE_K84" ]]; then
    return 0
  fi
  if [[ "$database_migration" == "$DATABASE_MIGRATION_KV2" && "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    return 0
  fi
  die 'RELEASE_POLICY_PAIR_NOT_ALLOWED'
}

read_agent_interventions_env_state() {
  python3 - "$SERVICE_ENV" "$SERVICE_GROUP" <<'PY'
import grp
import os
from pathlib import Path
import stat
import sys

path = Path(sys.argv[1])
expected_gid = grp.getgrnam(sys.argv[2]).gr_gid
details = path.lstat()
if not stat.S_ISREG(details.st_mode) or path.is_symlink():
    raise SystemExit("SERVICE_ENV_UNSAFE")
if details.st_uid != 0 or details.st_gid != expected_gid or stat.S_IMODE(details.st_mode) != 0o640:
    raise SystemExit("SERVICE_ENV_METADATA_UNEXPECTED")

target = "AGENT_INTERVENTIONS_ENABLED"
values = []
for raw_line in path.read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("export "):
        line = line[7:].lstrip()
    key, separator, value = line.partition("=")
    if separator and key.strip() == target:
        values.append(value.strip())

if len(values) > 1:
    raise SystemExit("AGENT_INTERVENTIONS_ENV_DUPLICATED")
if not values:
    print("absent")
elif values[0] in {"true", "false"}:
    print(values[0])
else:
    raise SystemExit("AGENT_INTERVENTIONS_ENV_INVALID")
PY
}

write_agent_interventions_env_state() {
  local desired_state=$1
  [[ "$desired_state" == 'absent' || "$desired_state" == 'true' || "$desired_state" == 'false' ]]
  python3 - "$SERVICE_ENV" "$SERVICE_GROUP" "$desired_state" <<'PY'
import grp
import os
from pathlib import Path
import stat
import sys

path = Path(sys.argv[1])
expected_gid = grp.getgrnam(sys.argv[2]).gr_gid
desired = sys.argv[3]
details = path.lstat()
if not stat.S_ISREG(details.st_mode) or path.is_symlink():
    raise SystemExit("SERVICE_ENV_UNSAFE")
if details.st_uid != 0 or details.st_gid != expected_gid or stat.S_IMODE(details.st_mode) != 0o640:
    raise SystemExit("SERVICE_ENV_METADATA_UNEXPECTED")

target = "AGENT_INTERVENTIONS_ENABLED"
output = []
seen = 0
for raw_line in path.read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    candidate = line[7:].lstrip() if line.startswith("export ") else line
    key, separator, value = candidate.partition("=")
    if separator and key.strip() == target:
        seen += 1
        if value.strip() not in {"true", "false"}:
            raise SystemExit("AGENT_INTERVENTIONS_ENV_INVALID")
        if desired != "absent":
            output.append(f"{target}={desired}")
    else:
        output.append(raw_line)

if seen > 1:
    raise SystemExit("AGENT_INTERVENTIONS_ENV_DUPLICATED")
if seen == 0 and desired != "absent":
    output.append(f"{target}={desired}")

payload = ("\n".join(output).rstrip("\n") + "\n").encode("utf-8")
temporary = path.with_name(f".{path.name}.lumi-release-{os.getpid()}.tmp")
flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
try:
    descriptor = os.open(temporary, flags, 0o640)
    try:
        offset = 0
        while offset < len(payload):
            offset += os.write(descriptor, payload[offset:])
        os.fchown(descriptor, 0, expected_gid)
        os.fchmod(descriptor, 0o640)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
except BaseException:
    try:
        temporary.unlink()
    except FileNotFoundError:
        pass
    raise
directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
  [[ "$(read_agent_interventions_env_state)" == "$desired_state" ]]
}

