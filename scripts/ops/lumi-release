    printf 'audit_harness_sha256=%s\n' "$harness_sha"
  } >> "$seal_tmp"
  chown root:root "$seal_tmp"
  chmod 0600 "$seal_tmp"
  mv -f -- "$seal_tmp" "$seal"
}

prepare() {
  local commit=$1
  local run_id
  local input_root_real
  local input_dir
  local stage
  local manifest
  local expected_current
  local source_sha256
  local built_sha256
  local build_id
  local esbuild_version
  local database_migration
  local environment_write
  local environment_previous
  local source_archive
  local built_archive
  local release

  assert_commit "$commit"
  assert_operations_roots
  input_root_real=$(realpath -e -- "$INPUT_ROOT")
  input_dir=$(realpath -e -- "$INPUT_ROOT/$commit")
  [[ "$input_dir" == "$input_root_real/$commit" && -d "$input_dir" && ! -L "$input_dir" ]]
  for required in manifest manifest.sig source.tar built.tar.gz; do
    [[ -f "$input_dir/$required" && ! -L "$input_dir/$required" ]]
  done

  run_id="prepare-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence prepare "$run_id"
  ACTIVE_COMMIT="$commit"
  stage="$WORK_ROOT/$run_id"
  [[ ! -e "$stage" && ! -L "$stage" ]]
  install -d -o root -g root -m 0700 "$stage"
  log 'STAGE=PREFLIGHT'
  service_preflight "$ACTIVE_EVIDENCE/before-health.json"

  copy_regular_input "$input_dir/manifest" "$stage/manifest" - > "$ACTIVE_EVIDENCE/manifest.sha256"
  copy_regular_input "$input_dir/manifest.sig" "$stage/manifest.sig" - > "$ACTIVE_EVIDENCE/manifest-signature.sha256"
  ssh-keygen -Y verify -f "$ALLOWED_SIGNERS" -I "$SIGNER_IDENTITY" -n "$SIGNATURE_NAMESPACE" -s "$stage/manifest.sig" < "$stage/manifest" > "$ACTIVE_EVIDENCE/signature-verification.txt"
  validate_manifest "$stage/manifest" "$commit" | tee -a "$ACTIVE_EVIDENCE/summary.log"

  manifest="$stage/manifest"
  expected_current=$(manifest_field "$manifest" expected_current)
  source_sha256=$(manifest_field "$manifest" source_sha256)
  built_sha256=$(manifest_field "$manifest" built_sha256)
  build_id=$(manifest_field "$manifest" build_id)
  esbuild_version=$(manifest_field "$manifest" esbuild_version)
  database_migration=$(manifest_field "$manifest" database_migration)
  environment_write=$(manifest_field "$manifest" environment_write)
  assert_release_policy "$database_migration" "$environment_write"
  if [[ "$environment_write" == "$ENVIRONMENT_WRITE_K84" ]]; then
    environment_previous=$(read_agent_interventions_env_state)
  elif [[ "$environment_write" == "$ENVIRONMENT_WRITE_KV2" ]]; then
    environment_previous=$(read_knowledge_v2_boolean_env_state)
    assert_knowledge_v2_canary_configured | tee -a "$ACTIVE_EVIDENCE/summary.log"
  else
    environment_previous='unmodified'
  fi
  source_archive="$stage/source.tar"
  built_archive="$stage/built.tar.gz"
  release="$RELEASE_ROOT/$commit"
  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  [[ ! -e "$release" && ! -L "$release" ]]

  copy_regular_input "$input_dir/source.tar" "$source_archive" "$source_sha256" > "$ACTIVE_EVIDENCE/source.sha256"
  copy_regular_input "$input_dir/built.tar.gz" "$built_archive" "$built_sha256" > "$ACTIVE_EVIDENCE/built.sha256"
  validate_archive "$source_archive" "$stage/source.executables" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  validate_archive "$built_archive" "$stage/built.executables" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  consume_verified_input_directory "$input_dir"
  printf 'SIGNED_INPUT_CONSUMED=YES\n' | tee -a "$ACTIVE_EVIDENCE/summary.log"

  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'CURRENT_BEFORE=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'EXPECTED_CURRENT=%s\n' "$expected_current"
    printf 'SOURCE_ARCHIVE_SHA256=%s\n' "$source_sha256"
    printf 'BUILT_ARCHIVE_SHA256=%s\n' "$built_sha256"
    printf 'BUILD_ID=%s\n' "$build_id"
    printf 'DATABASE_MIGRATION=%s\n' "$database_migration"
    printf 'ENVIRONMENT_WRITE=%s\n' "$environment_write"
    printf 'ENVIRONMENT_PREVIOUS=%s\n' "$environment_previous"
  } > "$ACTIVE_EVIDENCE/PREFLIGHT.txt"

  log 'STAGE=RESTORE_POINT'
  "$BACKUP_WRAPPER" > "$ACTIVE_EVIDENCE/backup-wrapper.log" 2>&1
  grep -Fqx 'STATUS=SUCCEEDED' "$ACTIVE_EVIDENCE/backup-wrapper.log"
  systemctl is-active --quiet "$SERVICE"
  capture_base_health "$ACTIVE_EVIDENCE/after-backup-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  grep -E '^(BACKUP_PATH|RESTORE_POINT|STATUS)=' "$ACTIVE_EVIDENCE/backup-wrapper.log" > "$ACTIVE_EVIDENCE/restore-point.txt" || true

  log 'STAGE=PREPARE_RELEASE'
  install -d -o root -g "$SERVICE_GROUP" -m 0750 "$release"
  tar --no-same-owner --no-same-permissions --delay-directory-restore -xf "$source_archive" -C "$release"
  tar --no-same-owner --no-same-permissions --delay-directory-restore -xzf "$built_archive" -C "$release"
  chown -hR root:"$SERVICE_GROUP" "$release"
  find "$release" -xdev -type d -exec chmod 0750 {} +
  find "$release" -xdev -type f -exec chmod 0640 {} +
  if [[ "$database_migration" == "$DATABASE_MIGRATION_INSPIRATION_D27" ]]; then
    local knowledge_repair_root="$release/.lumi-d27-knowledge-repair"
    reconstruct_knowledge_v2_corpus_for_d27 \
      "$RELEASE_ROOT/$expected_current" "$release" "$knowledge_repair_root" \
      | tee "$ACTIVE_EVIDENCE/knowledge-v2-corpus-repair.log"
    inherit_knowledge_v2_runtime_for_d27 \
      "$RELEASE_ROOT/$expected_current" "$release" "$knowledge_repair_root" \
      | tee "$ACTIVE_EVIDENCE/knowledge-v2-runtime-inherit.log"
    clone_knowledge_v2_runtime_tree_for_d27 \
      "$RELEASE_ROOT/$expected_current" "$release" \
      | tee "$ACTIVE_EVIDENCE/knowledge-v2-runtime-tree-clone.log"
    rm -rf -- "$knowledge_repair_root"
  fi
  test -s "$release/.next/BUILD_ID"
  [[ "$(cat "$release/.next/BUILD_ID")" == "$build_id" ]]
  test -r "$release/node_modules/tsx/dist/cli.mjs"
  test -r "$release/scripts/start-local-host.ts"
  chown -hR root:"$SERVICE_GROUP" "$release"
  find "$release" -xdev -type d -exec chmod 0750 {} +
  find "$release" -xdev -type f -exec chmod 0640 {} +
  repair_executable_permissions "$release" "$stage/source.executables" "$stage/built.executables" "$ACTIVE_EVIDENCE/executable-permissions.tsv" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  if [[ "$database_migration" == "$DATABASE_MIGRATION_INSPIRATION_D27" ]]; then
    repair_knowledge_v2_python_permission "$release" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  fi
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0770 "$release/.next/cache"
  write_release_source_binding "$release" "$commit"
  write_release_marker "$release" "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"
  verify_release "$commit" "$build_id" "$esbuild_version" "$database_migration" "$environment_write"

  [[ "$(readlink -f "$CURRENT_LINK")" == "$RELEASE_ROOT/$expected_current" ]]
  systemctl is-active --quiet "$SERVICE"
  capture_base_health "$ACTIVE_EVIDENCE/final-precutover-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  write_seal "$run_id" "$commit" "$expected_current" "$build_id" "$esbuild_version" "$database_migration" "$environment_write" "$environment_previous"
  {
    printf 'SOURCE_COMMIT=%s\n' "$commit"
    printf 'EXPECTED_CURRENT=%s\n' "$expected_current"
    printf 'RELEASE=%s\n' "$release"
    printf 'BUILD_ID=%s\n' "$build_id"
    printf 'DATABASE_MIGRATION=%s\n' "$database_migration"
    printf 'ENVIRONMENT_WRITE=%s\n' "$environment_write"
    printf 'ENVIRONMENT_PREVIOUS=%s\n' "$environment_previous"
    printf 'RELEASE_MARKER=PASS\n'
    printf 'SERVICE_ACCESS_PRECHECK=PASS\n'
    printf 'CURRENT_AFTER=%s\n' "$(readlink -f "$CURRENT_LINK")"
    printf 'CUTOVER=NOT_PERFORMED\n'
    printf 'STATUS=PREPARED\n'
  } > "$ACTIVE_EVIDENCE/PREPARED.result"
  finalize_evidence
  ACTIVE_EVIDENCE=''

  printf 'PREPARED=YES\n'
  printf 'RUN_ID=%s\n' "$run_id"
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$run_id"
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  printf 'CUTOVER=NOT_PERFORMED\n'
  printf 'CUTOVER_CONFIRMATION=ROOT_SEALED\n'
}

