release_reference_count() {
  local release=$1
  local candidate
  local resolved
  local count=0

  shopt -s nullglob
  for candidate in /proc/[0-9]*/exe /proc/[0-9]*/cwd /proc/[0-9]*/root /proc/[0-9]*/fd/*; do
    resolved=$(readlink -f -- "$candidate" 2>/dev/null || true)
    if [[ "$resolved" == "$release" || "$resolved" == "$release/"* ]]; then
      count=$((count + 1))
    fi
  done
  shopt -u nullglob

  while IFS= read -r -d '' candidate; do
    resolved=$(readlink -f -- "$candidate" 2>/dev/null || true)
    if [[ "$resolved" == "$release" || "$resolved" == "$release/"* ]]; then
      count=$((count + 1))
    fi
  done < <(find /opt/lumi -xdev -maxdepth 2 -type l -print0)

  printf '%s\n' "$count"
}

release_seal_count() {
  local commit=$1
  local seal
  local count=0

  shopt -s nullglob
  for seal in "$SEAL_ROOT"/*.seal; do
    [[ -f "$seal" && ! -L "$seal" ]]
    if [[ "$(seal_field "$seal" source_commit)" == "$commit" ]]; then
      count=$((count + 1))
    fi
  done
  shopt -u nullglob
  printf '%s\n' "$count"
}

release_inventory() {
  local current
  local release
  local name
  local bytes
  local marker
  local marker_commit='NONE'
  local complete='NO'
  local successful_cutovers=0
  local failed_cutovers=0
  local references
  local is_current

  assert_operations_roots
  [[ -d "$RELEASE_ROOT" && ! -L "$RELEASE_ROOT" ]]
  [[ -L "$CURRENT_LINK" ]]
  current=$(readlink -f "$CURRENT_LINK")
  [[ "$current" == "$RELEASE_ROOT/"* ]]
  printf 'CURRENT=%s\n' "$current"

  while IFS= read -r -d '' release; do
    name=$(basename -- "$release")
    bytes=$(du -sb -- "$release" | awk '{print $1}')
    [[ "$bytes" =~ ^[1-9][0-9]*$ ]]
    marker="$release/.lumi-deploy-complete"
    marker_commit='NONE'
    complete='NO'
    successful_cutovers=0
    failed_cutovers=0
    if [[ -f "$marker" && ! -L "$marker" ]]; then
      marker_commit=$(awk -F= '$1 == "source_commit" { print $2 }' "$marker")
      if [[ "$marker_commit" =~ ^[0-9a-f]{40}$ ]]; then
        complete='YES'
        successful_cutovers=$(successful_cutover_evidence_count "$marker_commit")
        failed_cutovers=$(failed_cutover_evidence_count "$marker_commit")
      fi
    fi
    references=$(release_reference_count "$release")
    if [[ "$release" == "$current" ]]; then
      is_current='YES'
    else
      is_current='NO'
    fi
    printf 'RELEASE=%s|BYTES=%s|COMPLETE=%s|MARKER_COMMIT=%s|SUCCESSFUL_CUTOVERS=%s|FAILED_CUTOVERS=%s|REFERENCES=%s|CURRENT=%s\n' \
      "$name" "$bytes" "$complete" "$marker_commit" "$successful_cutovers" "$failed_cutovers" "$references" "$is_current"
  done < <(find "$RELEASE_ROOT" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

  systemctl is-active --quiet "$SERVICE"
  status_health
}

prune_retired_releases() {
  [[ "$#" -ge 1 && "$#" -le 32 ]] || die 'PRUNE_RETIRED_REQUIRES_ONE_TO_32_COMMITS'

  local current
  local current_commit
  local current_success_count
  local commit
  local release
  local marker
  local success_count
  local reference_count
  local seal_count
  local released_bytes
  local total_released_bytes=0
  local removed_releases=0
  local run_id
  local -a commits=()
  declare -A seen=()

  assert_operations_roots
  [[ -d "$RELEASE_ROOT" && ! -L "$RELEASE_ROOT" ]]
  [[ -L "$CURRENT_LINK" ]]
  current=$(readlink -f "$CURRENT_LINK")
  [[ "$current" == "$RELEASE_ROOT/"* ]]
  current_commit=$(basename -- "$current")
  assert_commit "$current_commit"
  current_success_count=$(successful_cutover_evidence_count "$current_commit")
  [[ "$current_success_count" =~ ^[1-9][0-9]*$ ]] || die 'CURRENT_RELEASE_HAS_NO_SUCCESSFUL_CUTOVER_EVIDENCE'

  for commit in "$@"; do
    assert_commit "$commit"
    [[ -z "${seen[$commit]:-}" ]] || die "PRUNE_RETIRED_DUPLICATE_COMMIT:$commit"
    seen[$commit]=1
    release="$RELEASE_ROOT/$commit"
    marker="$release/.lumi-deploy-complete"
    [[ "$release" != "$current" ]] || die 'PRUNE_RETIRED_REFUSES_CURRENT'
    [[ -d "$release" && ! -L "$release" ]] || die "PRUNE_RETIRED_RELEASE_UNSAFE:$commit"
    [[ "$(realpath -e -- "$release")" == "$release" ]] || die "PRUNE_RETIRED_RELEASE_PATH_MISMATCH:$commit"
    ! mountpoint -q -- "$release" || die "PRUNE_RETIRED_RELEASE_IS_MOUNTPOINT:$commit"
    [[ "$(stat -c '%U:%G:%a' -- "$release")" == "root:$SERVICE_GROUP:750" ]] || die "PRUNE_RETIRED_RELEASE_METADATA_UNEXPECTED:$commit"
    [[ -f "$marker" && ! -L "$marker" ]] || die "PRUNE_RETIRED_MARKER_UNSAFE:$commit"
    [[ "$(stat -c '%U:%G:%a' -- "$marker")" == "root:$SERVICE_GROUP:640" ]] || die "PRUNE_RETIRED_MARKER_METADATA_UNEXPECTED:$commit"
    grep -Fqx "source_commit=$commit" "$marker" || die "PRUNE_RETIRED_MARKER_COMMIT_MISMATCH:$commit"
    success_count=$(successful_cutover_evidence_count "$commit")
    [[ "$success_count" =~ ^[1-9][0-9]*$ ]] || die "PRUNE_RETIRED_HAS_NO_SUCCESSFUL_CUTOVER_EVIDENCE:$commit"
    reference_count=$(release_reference_count "$release")
    [[ "$reference_count" == '0' ]] || die "PRUNE_RETIRED_RELEASE_STILL_REFERENCED:$commit:$reference_count"
    seal_count=$(release_seal_count "$commit")
    [[ "$seal_count" == '0' ]] || die "PRUNE_RETIRED_RELEASE_STILL_SEALED:$commit:$seal_count"
    commits+=("$commit")
  done

  run_id="prune-retired-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  make_evidence prune-retired "$run_id"
  ACTIVE_COMMIT="$current_commit"
  service_preflight "$ACTIVE_EVIDENCE/before-prune-base-health.json"
  capture_health "$ACTIVE_EVIDENCE/before-prune-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"

  for commit in "${commits[@]}"; do
    release="$RELEASE_ROOT/$commit"
    released_bytes=$(du -sb -- "$release" | awk '{print $1}')
    [[ "$released_bytes" =~ ^[1-9][0-9]*$ ]]
    printf 'SOURCE_COMMIT=%s|RELEASED_BYTES=%s\n' "$commit" "$released_bytes" >> "$ACTIVE_EVIDENCE/pruned-releases.txt"
    rm -rf --one-file-system -- "$release"
    [[ ! -e "$release" && ! -L "$release" ]]
    total_released_bytes=$((total_released_bytes + released_bytes))
    removed_releases=$((removed_releases + 1))
  done

  [[ "$(readlink -f "$CURRENT_LINK")" == "$current" ]]
  systemctl is-active --quiet "$SERVICE"
  capture_health "$ACTIVE_EVIDENCE/after-prune-health.json" | tee -a "$ACTIVE_EVIDENCE/summary.log"
  {
    printf 'CURRENT_COMMIT=%s\n' "$current_commit"
    printf 'REMOVED_RELEASES=%s\n' "$removed_releases"
    printf 'RELEASED_BYTES=%s\n' "$total_released_bytes"
    printf 'CURRENT_UNCHANGED=%s\n' "$current"
    printf 'PRODUCTION_CHANGED=NO\n'
    printf 'STATUS=SUCCEEDED\n'
  } > "$ACTIVE_EVIDENCE/SUCCEEDED.result"
  finalize_evidence
  ACTIVE_EVIDENCE=''

  printf 'RETIRED_RELEASES_PRUNED=YES\n'
  printf 'REMOVED_RELEASES=%s\n' "$removed_releases"
  printf 'RELEASED_BYTES=%s\n' "$total_released_bytes"
  printf 'CURRENT=%s\n' "$(readlink -f "$CURRENT_LINK")"
  printf 'PRODUCTION_CHANGED=NO\n'
  printf 'EVIDENCE=%s\n' "$EVIDENCE_ROOT/$run_id"
}

