  "longSession": {
    "id": "benchmark-20-turn-continuity",
    "goalIncludes": "校园非遗节",
    "minimumBriefFields": 8,
    "maxQuestionsPerTurn": 1,
    "turns": [
      { "message": "我要为校园非遗节建立一套年轻但不幼稚的视觉识别。" },
      { "message": "主要给第一次接触非遗的新生看。" },
      { "message": "使用场景先放在校园入口和社交媒体。" },
      { "message": "核心内容是让大家愿意走进现场体验。" },
      { "message": "视觉上想保留手工痕迹，但不要做成仿古。" },
      { "message": "颜色可以鲜明一些，但要控制数量。" },
      { "message": "字体需要兼顾活动感和信息清楚。" },
      { "message": "第一轮先做海报、导视和手机端封面。" },
      { "message": "预算不高，印刷工艺只能选一种。" },
      { "message": "帮我把制作顺序排一下。" },
      { "message": "海报和导视怎样保持同一个识别系统？" },
      { "message": "什么指标能判断新生真的看懂了？" },
      { "message": "我准备先做三张黑白构图。" },
      { "message": "同学说第二张更活泼，但标题不够突出。" },
      { "message": "那我先只调整标题层级，不换整体方向。" },
      { "message": "社交媒体封面需要从海报里保留什么？" },
      { "message": "前面确认的受众和设计目标是什么？" },
      { "message": "不要改变已经确认的目标，只补充媒介限制。" },
      { "message": "现在最适合执行的下一步是什么？" },
      { "message": "最后用一句话总结当前项目理解。" }
    ]
  },
