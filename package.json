{
  "name": "tonggan-course-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "predev": "node scripts/check-runtime-tools.mjs --tools next",
    "dev": "next dev",
    "prebuild": "node scripts/check-runtime-tools.mjs --tools next",
    "build": "next build",
    "prestart": "pnpm evidence:recover",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "pretest": "node scripts/check-runtime-tools.mjs --tools vitest",
    "test": "vitest run",
    "pretest:watch": "node scripts/check-runtime-tools.mjs --tools vitest",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:all": "pnpm audit --registry=https://registry.npmjs.org",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "predb:generate": "node scripts/check-runtime-tools.mjs --tools drizzle-kit",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "node scripts/check-runtime-tools.mjs --tools tsx",
    "db:migrate": "tsx lib/db/migrate.ts",
    "predb:seed": "node scripts/check-runtime-tools.mjs --tools tsx",
    "db:seed": "tsx scripts/seed-demo.ts",
    "preknowledge:ingest": "node scripts/check-runtime-tools.mjs --tools tsx",
    "knowledge:ingest": "tsx scripts/ingest-knowledge.ts",
    "runtime:preflight": "node scripts/check-runtime-tools.mjs --tools tsx,next,vitest,drizzle-kit",
    "preagent:eval": "node scripts/check-runtime-tools.mjs --tools tsx",
    "agent:eval": "tsx scripts/evaluate-agent.ts",
    "premodel:latency": "node scripts/check-runtime-tools.mjs --tools tsx",
    "model:latency": "tsx scripts/measure-model-latency.ts",
    "preagent:benchmark": "node scripts/check-runtime-tools.mjs --tools tsx",
    "agent:benchmark": "tsx scripts/benchmark-agent-runtime.ts",
    "preagent:harness": "node scripts/check-runtime-tools.mjs --tools tsx",
    "agent:harness": "tsx scripts/run-agent-harness.ts",
    "pretutor:quality": "node scripts/check-runtime-tools.mjs --tools tsx",
    "tutor:quality": "tsx scripts/evaluate-tutor-quality.ts",
    "pretutor:promotion:verify": "node scripts/check-runtime-tools.mjs --tools tsx",
    "tutor:promotion:verify": "tsx scripts/verify-tutor-promotion.ts",
    "demo-agent:reset": "tsx scripts/reset-demo-agent-history.ts",
    "agent:messages:backfill": "tsx scripts/backfill-agent-messages.ts",
    "pilot:prepare": "tsx scripts/prepare-pilot.ts",
    "pilot:observation": "tsx scripts/generate-pilot-observation-pack.ts",
    "pilot:preflight": "tsx scripts/preflight-pilot.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "qr:generate": "tsx scripts/generate-qr.ts",
    "td:import": "tsx scripts/import-touchdesigner-cases.ts",
    "backup:create": "tsx scripts/create-backup.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "evidence:recover": "tsx scripts/recover-evidence.ts",
    "local-host:setup": "tsx scripts/setup-local-host.ts",
    "local-host:prepare": "tsx scripts/prepare-local-release.ts",
    "prelocal-host:start": "node scripts/check-runtime-tools.mjs --tools tsx",
    "local-host:start": "tsx scripts/start-local-host.ts",
    "local-host:verify": "tsx scripts/verify-local-host.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.27",
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@next/env": "16.2.10",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.6.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.45.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.31",
    "better-auth": "1.6.25",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "ipaddr.js": "2.2.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "maath": "^0.10.8",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next": "16.2.10",
    "ogl": "^1.0.11",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "three": "^0.180.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
