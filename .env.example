# Project-local development template. Service-aware commands prefer the external
# %LOCALAPPDATA%\ChuyingAI\config\service.env (or explicit CHUYING_SERVICE_ENV).
# That file is outside the repository, is shared by all worktrees, and its entire
# inference configuration family overrides project LLM_* / AGENT_* timeout values.
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/course-dev.sqlite
# Must be a private directory exclusively controlled by the service account.
# It must neither be inside public/ nor contain public/.
EVIDENCE_ROOT=./data/evidence-dev
TEACHER_ACCESS_CODE=replace-with-a-private-teacher-code
IDENTITY_CODE_PEPPER=replace-with-an-identity-code-pepper
AUTH_PROXY_SECRET=replace-with-an-auth-proxy-secret

# Local demonstration commands only. Production seeding is rejected even if this is true.
ALLOW_DEMO_SEED=true
SEED_AFTER_RESET=false

# Set only after a new public host has been confirmed. QR generation rejects local/private hosts.
# PUBLIC_APP_URL=

# Optional paired student-number masking policy. Configure both or neither.
# Prefix: school-specific ASCII letters (1-12); digits: 4-20.
# Production rejects generic prefixes such as DEMO, TEST, STUDENT, and SAMPLE.
# STUDENT_NUMBER_PREFIX=<school-specific-letters>
# STUDENT_NUMBER_DIGITS=<4-to-20>

# Optional project-development tutor configuration. Do not copy production keys here.
# Service-aware commands report the effective base URL and safe source on stderr.
# AI is enabled only when all three values are configured.
# LLM_BASE_URL=https://approved-chat-endpoint.example/v1
# LLM_API_KEY=replace-with-your-api-key
# LLM_MODEL=<approved-chat-model>
# Optional semantic vectorizer. This is not a second tutor/chat model.
# Leave all three unset for lexical-only retrieval. When chat is configured, each omitted embedding
# URL/key falls back to its chat counterpart. Embedding-only operation requires all three values.
# LLM_EMBEDDING_BASE_URL=https://approved-embedding-endpoint.example/v1
# LLM_EMBEDDING_API_KEY=replace-with-your-embedding-api-key
# LLM_EMBEDDING_MODEL=<approved-embedding-model>
# Default 4096; configure from 1 up to the application hard limit of 4096.
# LLM_MAX_OUTPUT_TOKENS=4096
# Set true only when the endpoint accepts Chat image_url or Responses input_image content.
# LLM_VISION_ENABLED=true

# Agent timeout profiles in milliseconds. Streaming idle resets on every non-empty transport chunk;
# hard totals never reset. Each profile must satisfy idle < model total < turn total.
# AGENT_MODEL_IDLE_TIMEOUT_MS=75000
# AGENT_MODEL_TOTAL_TIMEOUT_MS=600000
# AGENT_TURN_TOTAL_TIMEOUT_MS=900000
# AGENT_EVAL_MODEL_IDLE_TIMEOUT_MS=120000
# AGENT_EVAL_MODEL_TOTAL_TIMEOUT_MS=600000
# AGENT_EVAL_TURN_TOTAL_TIMEOUT_MS=900000

# Competition agent release switch. Set false to temporarily restore the legacy local mentor.
AGENT_V2_ENABLED=true
AGENT_V3_ENABLED=false
# Web 运行中补充 / 改向。首切片只开放文字，默认关闭以便独立回退。
AGENT_INTERVENTIONS_ENABLED=false
# 最近一次真实模型Agent质量评测报告；外置 service.env 中的绝对路径会覆盖此值。
# 多个 worktree 会共享该报告、断点和全局锁，禁止并行运行评测。
AGENT_EVAL_REPORT_PATH=./.runtime/agent-eval/latest.json
# 最近一次确定性Agent异常路径Harness报告；竞赛就绪门要求全部场景通过。
AGENT_HARNESS_REPORT_PATH=./.runtime/agent-harness/latest.json
