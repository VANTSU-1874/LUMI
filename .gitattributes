# Preserve byte-pinned upstream license text. TorchVision's official source has
# a significant trailing space, so whitespace checks must not rewrite any text.
/third_party/knowledge-v2/LICENSE-*.txt text eol=lf -whitespace

# Drizzle records a SHA-256 of raw SQL text. Keep future checkouts stable while
# the migrator remains compatible with hashes created from earlier CRLF copies.
/drizzle/*.sql text eol=lf

# D-27 release manifests bind exact byte digests. Keep Git archive export
# semantics identical to the bytes hashed by the bundle builder.
/data/inspiration-wiki/production-release/**/*.json text eol=lf
